{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!tmp",
      "!node_modules",
      "!.astro",
      "!public",
      "!data/media",
      "!test-results",
      "!playwright-report"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error",
        "useTemplate": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        }
      },
      "complexity": {
        "noForEach": "off",
        "useLiteralKeys": "off"
      },
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentWidth": 2,
      "lineWidth": 100
    }
  },
  "overrides": [
    {
      "includes": ["data/**/*.json", "schemas/**/*.json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["tools/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["src/scripts/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    },
    {
      "includes": ["src/styles/base.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/lib/atlas/vocabulary.ts",
        "src/lib/atlas/contract/**",
        "src/lib/atlas/world/**",
        "src/lib/atlas/kernel/**",
        "src/lib/atlas/worker/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "three": "This module also runs in the Atlas worker, which has neither three nor the DOM: only src/lib/atlas/engine renders.",
                  "react": "This module also runs in the Atlas worker: interface and page code stays in src/islands and src/scripts.",
                  "react-dom": "This module also runs in the Atlas worker: interface and page code stays in src/islands and src/scripts.",
                  "motion": "This module also runs in the Atlas worker: interface and page code stays in src/islands and src/scripts."
                },
                "patterns": [
                  {
                    "group": ["three/**"],
                    "message": "This module also runs in the Atlas worker, which has neither three nor the DOM: only src/lib/atlas/engine renders."
                  },
                  {
                    "group": ["**/engine/**", "**/islands/**", "**/scripts/**"],
                    "message": "This module also runs in the Atlas worker: interface and page code stays in src/islands and src/scripts."
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "document": "This module also runs in the Atlas worker, which has neither three nor the DOM: only src/lib/atlas/engine renders.",
                  "window": "This module also runs in the Atlas worker, which has neither three nor the DOM: only src/lib/atlas/engine renders.",
                  "localStorage": "This module also runs in the Atlas worker, which has neither three nor the DOM: only src/lib/atlas/engine renders.",
                  "requestAnimationFrame": "This module also runs in the Atlas worker, which has neither three nor the DOM: only src/lib/atlas/engine renders."
                }
              }
            }
          }
        }
      }
    }
  ]
}
