{
  "$id": "https://aubaine.io/schema/atlas-establishments.json",
  "title": "Établissements d'un monde",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "establishments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Identifiant d'un lieu, d'un lieu remarquable, d'une voie ou d'un établissement de l'Atlas."
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Genre d'établissement, déclaré dans data/atlas/vocabularies.json."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "place": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Le quartier, le village ou la caverne qui l'abrite."
          },
          "tile": {
            "type": "object",
            "properties": {
              "column": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Colonne du hex, comptée depuis zéro à partir de l'ouest."
              },
              "row": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Rangée du hex, comptée depuis zéro à partir du nord. Les rangées impaires sont décalées d'un demi-hex vers l'est."
              }
            },
            "required": [
              "column",
              "row"
            ],
            "additionalProperties": false,
            "description": "Le hex où il se trouve, dans ce lieu et à son niveau."
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "place",
          "tile"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "establishments"
  ],
  "additionalProperties": false,
  "description": "Les établissements d'un monde : tavernes, temples, forges."
}
