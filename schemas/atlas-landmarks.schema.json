{
  "$id": "https://aubaine.io/schema/atlas-landmarks.json",
  "title": "Lieux remarquables d'un monde",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "landmarks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "skycity",
                  "skyisle"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Identifiant d'un lieu, d'un lieu remarquable, d'une voie ou d'un établissement de l'Atlas."
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "place": {
                "description": "Le lieu auquel il appartient.",
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "tile": {
                "type": "object",
                "properties": {
                  "column": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Colonne du hex, comptée depuis zéro à partir de l'ouest."
                  },
                  "row": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Rangée du hex, comptée depuis zéro à partir du nord. Les rangées impaires sont décalées d'un demi-hex vers l'est."
                  }
                },
                "required": [
                  "column",
                  "row"
                ],
                "additionalProperties": false,
                "description": "Un hex de la grille du monde."
              },
              "height": {
                "description": "Hauteur approximative, en mètres.",
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "length": {
                "description": "Longueur approximative, en mètres.",
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "altitude": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Altitude de l'île volante, en mètres. Elle fixe sa hauteur sur la carte."
              },
              "features": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "watchtower",
                    "standing-stones",
                    "chains"
                  ]
                },
                "description": "Ce que la carte pose sur l'île : watchtower, une tour de guet ; standing-stones, un cercle de pierres levées ; chains, les chaînes qui la retiennent au sol."
              }
            },
            "required": [
              "kind",
              "id",
              "name",
              "tile",
              "altitude"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "worldtree",
                  "shipwreck",
                  "castle",
                  "arena",
                  "volcano",
                  "spire",
                  "bones",
                  "lighthouse",
                  "portal",
                  "tower"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Identifiant d'un lieu, d'un lieu remarquable, d'une voie ou d'un établissement de l'Atlas."
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "place": {
                "description": "Le lieu auquel il appartient.",
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "tile": {
                "type": "object",
                "properties": {
                  "column": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Colonne du hex, comptée depuis zéro à partir de l'ouest."
                  },
                  "row": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Rangée du hex, comptée depuis zéro à partir du nord. Les rangées impaires sont décalées d'un demi-hex vers l'est."
                  }
                },
                "required": [
                  "column",
                  "row"
                ],
                "additionalProperties": false,
                "description": "Un hex de la grille du monde."
              },
              "height": {
                "description": "Hauteur approximative, en mètres.",
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "length": {
                "description": "Longueur approximative, en mètres.",
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "footprint": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Rayon de son emprise autour du hex, en rayons de hex. Un hex mesure deux rayons d'une pointe à l'autre."
              },
              "altitude": {
                "description": "Altitude approximative de son sommet, en mètres.",
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "id",
              "name",
              "tile",
              "footprint"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "landmarks"
  ],
  "additionalProperties": false,
  "description": "Les lieux remarquables d'un monde, posés hors de la grille des hex."
}
