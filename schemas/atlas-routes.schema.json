{
  "$id": "https://aubaine.io/schema/atlas-routes.json",
  "title": "Voies d'un monde",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Identifiant d'un lieu, d'un lieu remarquable, d'une voie ou d'un établissement de l'Atlas."
          },
          "kind": {
            "type": "string",
            "enum": [
              "road",
              "trail",
              "rail",
              "sea",
              "river"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "object",
            "properties": {
              "column": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Colonne du hex, comptée depuis zéro à partir de l'ouest."
              },
              "row": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Rangée du hex, comptée depuis zéro à partir du nord. Les rangées impaires sont décalées d'un demi-hex vers l'est."
              }
            },
            "required": [
              "column",
              "row"
            ],
            "additionalProperties": false,
            "description": "Le premier hex de la voie."
          },
          "steps": {
            "type": "string",
            "pattern": "^[0-5]+$",
            "description": "Le chemin, un chiffre par pas vers le hex voisin : 0 à l'est, puis dans le sens des aiguilles d'une montre, 1 au sud-est, jusqu'à 5 au nord-est."
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "start",
          "steps"
        ],
        "additionalProperties": false
      }
    },
    "skyLanes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "landmark": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$",
                    "description": "Identifiant d'un lieu, d'un lieu remarquable, d'une voie ou d'un établissement de l'Atlas."
                  }
                },
                "required": [
                  "landmark"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "place": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$",
                    "description": "Identifiant d'un lieu, d'un lieu remarquable, d'une voie ou d'un établissement de l'Atlas."
                  }
                },
                "required": [
                  "place"
                ],
                "additionalProperties": false
              }
            ]
          },
          "to": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "landmark": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$",
                    "description": "Identifiant d'un lieu, d'un lieu remarquable, d'une voie ou d'un établissement de l'Atlas."
                  }
                },
                "required": [
                  "landmark"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "place": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$",
                    "description": "Identifiant d'un lieu, d'un lieu remarquable, d'une voie ou d'un établissement de l'Atlas."
                  }
                },
                "required": [
                  "place"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "description": "Les voies célestes des dirigeables, d'un lieu ou d'un lieu remarquable à un autre."
    }
  },
  "required": [
    "routes",
    "skyLanes"
  ],
  "additionalProperties": false,
  "description": "Les routes, sentiers, lignes, routes maritimes, rivières et voies célestes d'un monde."
}
