---
import { Image } from 'astro:assets'

import type { ArtEffect } from '../../lib/art-effect/effects'
import { artImage } from '../../lib/media'

type Props = {
  art?: string | undefined
  objectPosition?: string
  motion?: 'none' | 'drift' | 'zoom-drift' | 'burns'
  seconds?: number
  settle?: number
  large?: boolean
  priority?: boolean
  sizes?: string
  plate?: 'hero' | 'card' | undefined
  effect?: ArtEffect | undefined
}

const {
  art,
  objectPosition = '50% 30%',
  motion = 'drift',
  seconds = 24,
  settle = 2.2,
  large = false,
  priority = false,
  sizes = '100vw',
  plate,
  effect,
} = Astro.props

const image = artImage(art)
const suffix = large ? '-lg' : ''
const duration = Math.max(16, Math.min(36, seconds))

let animation = ''
if (motion === 'burns') {
  animation = 'au-burns 1s cubic-bezier(.4,.02,.28,1) both'
} else if (motion === 'drift') {
  animation = `au-idle${suffix} ${duration}s cubic-bezier(.37,0,.63,1) infinite`
} else if (motion === 'zoom-drift') {
  animation = `au-settle${suffix} ${settle}s cubic-bezier(.4,.02,.28,1) both, au-idle${suffix} ${duration}s cubic-bezier(.37,0,.63,1) ${settle}s infinite`
}

const fill = [
  'position:absolute',
  'inset:0',
  'width:100%',
  'height:100%',
  `object-fit:cover`,
  `object-position:${objectPosition}`,
]
const moving = [
  'will-change:transform',
  'backface-visibility:hidden',
  animation ? `animation:${animation}` : '',
  animation ? 'animation-play-state:var(--motion-state, running)' : '',
]
const join = (rules: string[]): string => rules.filter(Boolean).join('; ')
const widths = [640, 960, 1280, 1672, 2400, 3344]
const fetchpriority = priority ? 'high' : 'auto'
const decoding = priority ? 'sync' : 'async'
const picture = { alt: '', widths, sizes, layout: 'none', fetchpriority, decoding } as const
---

{
  image &&
    (plate ? (
      <span
        data-plate={plate}
        data-art-effect={effect}
        style={join(['position:absolute', 'inset:0', 'display:block', ...moving])}
      >
        <Image src={image} {...picture} style={join(fill)} />
      </span>
    ) : (
      <Image src={image} {...picture} style={join([...fill, ...moving])} />
    ))
}

<style is:global>
  [data-plate] > canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  [data-plate][data-developed] > img {
    visibility: hidden;
  }

  @media print {
    [data-plate] > canvas {
      display: none;
    }

    [data-plate][data-developed] > img {
      visibility: visible;
    }
  }
</style>
