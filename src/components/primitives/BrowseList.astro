---
import type { BrowseEntry } from '../../lib/game/browse-entries'
import type { Corpus } from '../../lib/game/corpus'
import type { Locale } from '../../lib/i18n/locales'
import { strings } from '../../lib/i18n/strings'
import FilterBar from './FilterBar.astro'
import Icon from './Icon.astro'
import ItemEntry from './ItemEntry.astro'
import SkillEntry from './SkillEntry.astro'
import StatusBadge from './StatusBadge.astro'

type Props = {
  locale: Locale
  corpus: Corpus
  entries: BrowseEntry[]
  label: string
  variant: 'skills' | 'speciesSkills' | 'equipment'
}

const { locale, corpus, entries, label, variant } = Astro.props
const t = strings(locale)
---

<FilterBar locale={locale} variant={variant} total={entries.length} />

<div
  data-browse={variant === 'equipment' ? 'equipment' : 'skills'}
  data-selection="static"
  style="max-width:1560px; margin:0 auto; padding:0 26px 80px; display:flex; flex-wrap:wrap; gap:0 34px; align-items:flex-start"
>
  <div style="flex:1 1 420px; min-width:0; padding:8px 0 0">
    <ul
      data-rows
      data-no-swup
      aria-label={label}
      style="list-style:none; margin:0; padding:0; border-top:1px solid var(--accent-line)"
    >
      {
        entries.map((entry) => (
          <li {...entry.attrs} style="border-bottom:1px solid var(--line)">
            <a
              href={`#e-${entry.id}`}
              data-row
              style="display:grid; width:100%; grid-template-columns:3px minmax(0,1.6fr) minmax(0,1fr) auto; align-items:center; gap:14px; text-align:left"
            >
              <span data-row-mark aria-hidden="true" style={`background:${entry.mark}`} />
              <span style="min-width:0">
                <span style="display:block; font-family:var(--font-display); font-size:17px; font-weight:600; color:var(--ink); overflow:hidden; text-overflow:ellipsis; white-space:nowrap">
                  {entry.title}
                </span>
                <span style="display:flex; align-items:center; gap:8px; min-width:0; padding-top:4px">
                  {entry.status && (
                    <StatusBadge status={entry.status} locale={locale} size="sm" />
                  )}
                  <span style="min-width:0; font-family:var(--font-ui); font-size:13px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--ink3); overflow:hidden; text-overflow:ellipsis; white-space:nowrap">
                    {entry.sub}
                  </span>
                </span>
              </span>
              <span style="min-width:0; font-family:var(--font-mono); font-size:11px; color:var(--ink3); overflow:hidden; text-overflow:ellipsis; white-space:nowrap">
                {entry.aside}
              </span>
              <span style="display:inline-flex; align-items:center; gap:9px; font-family:var(--font-ui); font-weight:700; font-size:14px; color:var(--gold); font-variant-numeric:tabular-nums">
                {entry.coins.length > 0
                  ? entry.coins.map((part) => (
                      <span class="au-coin" style={`--coin:${part.color}`}>
                        <Icon name={part.iconName} class="au-coin__icon" />
                        <span class="au-coin__amount">{part.amount}</span>
                        <span>{part.name}</span>
                      </span>
                    ))
                  : entry.value}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <aside
    aria-label={t.detail}
    data-details
    style="flex:1 1 370px; min-width:0; position:sticky; top:var(--sticky-top); scroll-margin-top:var(--sticky-top); padding:22px 0 0 26px; border-left:1px solid var(--accent-line); max-height:var(--sticky-max); overflow-x:clip; overflow-y:auto; overscroll-behavior:contain"
  >
    {
      entries.map((entry) => (
        <article data-detail id={`e-${entry.id}`}>
          {
            entry.entity.kind === 'skill' ? (
              <SkillEntry
                skill={entry.entity.skill}
                corpus={corpus}
                locale={locale}
                marks={false}
                priced={entry.entity.priced}
              />
            ) : (
              <ItemEntry item={entry.entity.item} corpus={corpus} locale={locale} />
            )
          }

          {entry.sources.length > 0 && (
            <div style="margin-top:22px; border-top:1px solid var(--accent-line); padding-top:15px; display:flex; flex-direction:column; gap:15px">
              <span style="font-family:var(--font-mono); font-size:9.5px; letter-spacing:.2em; text-transform:uppercase; color:var(--gold)">
                {t.provenance}
              </span>
              {entry.sources.map((group) =>
                group.kind === 'note' ? (
                  <span class="au-rule au-source-note" data-term="true" tabindex="0">
                    <Icon name="mdi:information-outline" class="au-rule__icon" />
                    <span>{group.label}</span>
                    <span class="au-rule__tip" data-tip="true" role="tooltip">
                      <span class="au-rule__tip-kind">{t.provenance}</span>
                      <span class="au-rule__tip-title">{group.label}</span>
                      <span class="au-rule__tip-body">{group.note}</span>
                    </span>
                  </span>
                ) : (
                  <div style="display:flex; flex-direction:column; gap:8px">
                    <span style="font-family:var(--font-ui); font-size:13px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:var(--ink3)">
                      {group.label}
                    </span>
                    <div style="display:flex; flex-wrap:wrap; gap:8px">
                      {group.links.map((link) => (
                        <a
                          href={link.href}
                          data-source
                          style="display:flex; align-items:baseline; gap:9px; padding:7px 12px; border:1px solid var(--line2); color:var(--ink); transition:border-color .2s var(--ease)"
                        >
                          <span style="font-family:var(--font-display); font-size:15px; font-weight:600">
                            {link.title}
                          </span>
                          <span style="font-family:var(--font-mono); font-size:9.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--ink3)">
                            {link.sub}
                          </span>
                        </a>
                      ))}
                    </div>
                  </div>
                ),
              )}
            </div>
          )}
        </article>
      ))
    }
  </aside>
</div>

<style>
  [data-row] {
    padding: 13px 8px 13px 0;
    scroll-margin-top: var(--sticky-top);
    transition:
      background-color 0.2s var(--ease),
      padding-left 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }
  [data-row-mark] {
    width: 3px;
    height: 22px;
    transition: height 0.2s var(--ease);
  }
  [data-row]:hover {
    background: var(--hover);
    padding-left: 7px;
  }
  [data-row][aria-current] {
    background: var(--bg3);
    padding-left: 7px;
    box-shadow: inset 2px 0 0 var(--gold);
  }
  [data-row][aria-current] [data-row-mark] {
    align-self: stretch;
    height: auto;
  }
  [data-source]:hover {
    border-color: var(--gold);
  }
  .au-source-note {
    align-self: flex-start;
    font-family: var(--font-ui);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: underline dotted;
    text-underline-offset: 0.3em;
    color: var(--ink3);
    cursor: help;
  }
  .au-source-note:hover,
  .au-source-note:focus-visible {
    color: var(--ink);
  }
  .au-source-note .au-rule__tip {
    letter-spacing: normal;
    text-transform: none;
    text-decoration: none;
  }
  [data-detail] {
    --detail-art: 112px;
    display: none;
    scroll-margin-top: var(--sticky-top);
    animation: au-fade 0.22s var(--ease) both;
  }
  [data-selection='static'] [data-detail]:target {
    display: block;
  }
  [data-selection='static'] [data-details]:not(:has(:target)) [data-detail]:first-child {
    display: block;
  }
  [data-selection='enhanced'] [data-detail][data-current] {
    display: block;
  }
  [data-browse]:not(:has([data-entry]:not([hidden]))) [data-details] {
    display: none;
  }
</style>
