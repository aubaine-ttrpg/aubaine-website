---
import type { BrowseEntry, BrowseSource } from '../../lib/game/browse-entries'
import type { Corpus } from '../../lib/game/corpus'
import type { Locale } from '../../lib/i18n/locales'
import { strings } from '../../lib/i18n/strings'
import FilterBar from './FilterBar.astro'
import Icon from './Icon.astro'
import ItemEntry from './ItemEntry.astro'
import SkillEntry from './SkillEntry.astro'
import StateEntry from './StateEntry.astro'
import StatusBadge from './StatusBadge.astro'
import TermEntry from './TermEntry.astro'

type Props = {
  locale: Locale
  corpus: Corpus
  entries: BrowseEntry[]
  label: string
} & (
  | { variant: 'skills' | 'equipment' | 'rules' }
  | { variant: 'speciesSkills'; subspeciesLabel: string }
)

const { locale, corpus, entries, label, variant } = Astro.props
const t = strings(locale)
const sourcesLabel = variant === 'speciesSkills' ? t.alsoAvailable : t.provenance
const drafts = entries.filter((entry) => entry.status === 'draft').length
const filter =
  Astro.props.variant === 'speciesSkills'
    ? { variant: 'speciesSkills' as const, subspeciesLabel: Astro.props.subspeciesLabel }
    : { variant: Astro.props.variant }

const SOURCE_ICONS: Record<BrowseSource['kind'], string> = {
  tree: 'mdi:family-tree',
  species: 'mdi:dna',
  item: 'mdi:shield-sword',
  basic: 'mdi:hexagon',
  bank: 'mdi:bank',
  other: 'mdi:information-outline',
}
const NOTES: Record<'basic' | 'bank' | 'other', string | undefined> = {
  basic: corpus.basic.note,
  bank: corpus.bank.note,
  other: t.otherNote,
}
---

<FilterBar locale={locale} total={entries.length} drafts={drafts} {...filter} />

<div
  data-browse={variant === 'speciesSkills' ? 'skills' : variant}
  data-selection="static"
  style="max-width:1560px; margin:0 auto; padding:0 26px 80px; display:flex; flex-wrap:wrap; gap:0 34px; align-items:flex-start"
>
  <div style="flex:1 1 420px; min-width:0; padding:8px 0 0">
    <ul
      data-rows
      data-no-swup
      aria-label={label}
      style="list-style:none; margin:0; padding:0; border-top:1px solid var(--accent-line)"
    >
      {
        entries.map((entry) => (
          <li {...entry.attrs} style="border-bottom:1px solid var(--line)">
            <a
              href={`#e-${entry.id}`}
              data-row
              style="display:grid; width:100%; grid-template-columns:3px minmax(0,1.6fr) minmax(0,1fr) auto; align-items:center; gap:14px; text-align:left"
            >
              <span data-row-mark aria-hidden="true" style={`background:${entry.mark}`} />
              <span style="min-width:0">
                <span style="display:block; font-family:var(--font-display); font-size:17px; font-weight:600; color:var(--ink); overflow:hidden; text-overflow:ellipsis; white-space:nowrap">
                  {entry.title}
                </span>
                <span style="display:flex; align-items:center; gap:8px; min-width:0; padding-top:4px">
                  {entry.status && (
                    <StatusBadge status={entry.status} locale={locale} size="sm" />
                  )}
                  <span style="min-width:0; font-family:var(--font-ui); font-size:13px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--ink3); overflow:hidden; text-overflow:ellipsis; white-space:nowrap">
                    {entry.sub}
                  </span>
                </span>
              </span>
              <span style="min-width:0; font-family:var(--font-mono); font-size:11px; color:var(--ink3); overflow:hidden; text-overflow:ellipsis; white-space:nowrap">
                {entry.aside}
              </span>
              <span style="display:inline-flex; align-items:center; gap:9px; font-family:var(--font-ui); font-weight:700; font-size:14px; color:var(--gold); font-variant-numeric:tabular-nums">
                {entry.coins.length > 0
                  ? entry.coins.map((part) => (
                      <span class="au-coin" style={`--coin:${part.color}`}>
                        <Icon name={part.iconName} class="au-coin__icon" />
                        <span class="au-coin__amount">{part.amount}</span>
                        <span>{part.name}</span>
                      </span>
                    ))
                  : entry.value}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <aside
    aria-label={t.detail}
    data-details
    style="flex:1 1 370px; min-width:0; position:sticky; top:var(--sticky-top); scroll-margin-top:var(--sticky-top); padding:22px 0 0 26px; border-left:1px solid var(--accent-line); max-height:var(--sticky-max); overflow-x:clip; overflow-y:auto; overscroll-behavior:contain"
  >
    {
      entries.map((entry) => (
        <article data-detail id={`e-${entry.id}`}>
          {entry.entity.kind === 'skill' && (
            <SkillEntry
              skill={entry.entity.skill}
              corpus={corpus}
              locale={locale}
              marks={false}
              priced={entry.entity.priced}
            />
          )}
          {entry.entity.kind === 'item' && (
            <ItemEntry item={entry.entity.item} corpus={corpus} locale={locale} />
          )}
          {entry.entity.kind === 'state' && (
            <StateEntry state={entry.entity.state} corpus={corpus} locale={locale} />
          )}
          {entry.entity.kind === 'term' && (
            <TermEntry term={entry.entity.term} corpus={corpus} locale={locale} />
          )}

          {entry.sources.length > 0 && (
            <div class="au-sources">
              <p class="au-sources__label" id={`src-${entry.id}`}>
                {sourcesLabel}
              </p>
              <ul class="au-sources__list" aria-labelledby={`src-${entry.id}`}>
                {entry.sources.map((source) => (
                  <li>
                    {'href' in source ? (
                      <a class="au-source" href={source.href}>
                        <Icon name={SOURCE_ICONS[source.kind]} class="au-source__icon" />
                        <span>{source.title}</span>
                      </a>
                    ) : (
                      <>
                        <button
                          type="button"
                          class="au-source"
                          popovertarget={`note-${source.kind}-${entry.id}`}
                          style={`anchor-name:--note-${source.kind}-${entry.id}`}
                        >
                          <Icon name={SOURCE_ICONS[source.kind]} class="au-source__icon" />
                          <span>{source.title}</span>
                        </button>
                        <div
                          popover
                          id={`note-${source.kind}-${entry.id}`}
                          class="au-source-note"
                          aria-labelledby={`note-${source.kind}-${entry.id}-title`}
                          style={`position-anchor:--note-${source.kind}-${entry.id}`}
                        >
                          <p class="au-source-note__kind">{sourcesLabel}</p>
                          <p class="au-source-note__title" id={`note-${source.kind}-${entry.id}-title`}>
                            {source.title}
                          </p>
                          <p class="au-source-note__body">{NOTES[source.kind]}</p>
                          <button
                            type="button"
                            class="au-source-note__close"
                            popovertarget={`note-${source.kind}-${entry.id}`}
                            popovertargetaction="hide"
                          >
                            {t.close}
                          </button>
                        </div>
                      </>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </article>
      ))
    }
  </aside>
</div>

<style>
  [data-row] {
    padding: 13px 8px 13px 0;
    scroll-margin-top: var(--sticky-top);
    transition:
      background-color 0.2s var(--ease),
      padding-left 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }
  [data-row-mark] {
    width: 3px;
    height: 22px;
    transition: height 0.2s var(--ease);
  }
  [data-row]:hover {
    background: var(--hover);
    padding-left: 7px;
  }
  [data-row][aria-current] {
    background: var(--bg3);
    padding-left: 7px;
    box-shadow: inset 2px 0 0 var(--gold);
  }
  [data-row][aria-current] [data-row-mark] {
    align-self: stretch;
    height: auto;
  }
  .au-sources {
    margin-top: 22px;
    padding-top: 15px;
    border-top: 1px solid var(--accent-line);
  }
  .au-sources__label {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .au-sources__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .au-source {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 13px;
    border: 1px solid var(--line2);
    background: var(--field);
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }
  .au-source:hover,
  .au-source:focus-visible {
    border-color: var(--gold);
    background: var(--accent-soft);
  }
  .au-source :global(.au-source__icon) {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--gold);
  }
  .au-source-note {
    width: min(400px, calc(100vw - 32px));
    padding: 18px 20px 16px;
    border: 1px solid var(--accent-line);
    background: var(--bg2);
    color: var(--ink);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }
  @supports (anchor-name: --a) {
    @media (min-width: 560px) {
      .au-source-note {
        inset: auto;
        margin: 8px 0;
        position-area: bottom span-right;
        position-try-fallbacks: flip-block, flip-inline;
      }
    }
  }
  .au-source-note__kind {
    margin: 0 0 6px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .au-source-note__title {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
  }
  .au-source-note__body {
    margin: 0 0 14px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink2);
  }
  .au-source-note__close {
    padding: 7px 13px;
    border: 1px solid var(--line2);
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .au-source-note__close:hover,
  .au-source-note__close:focus-visible {
    border-color: var(--gold);
  }
  [data-detail] {
    display: none;
    scroll-margin-top: var(--sticky-top);
    animation: au-fade 0.22s var(--ease) both;
  }
  [data-selection='static'] [data-detail]:target {
    display: block;
  }
  [data-selection='static'] [data-details]:not(:has(:target)) [data-detail]:first-child {
    display: block;
  }
  [data-selection='enhanced'] [data-detail][data-current] {
    display: block;
  }
  [data-browse]:not(:has([data-entry]:not([hidden]))) [data-details] {
    display: none;
  }
</style>
