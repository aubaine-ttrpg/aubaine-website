---
import type { BrowseEntry } from '../../lib/game/browse-entries'
import type { Corpus } from '../../lib/game/corpus'
import type { Locale } from '../../lib/i18n/locales'
import { strings } from '../../lib/i18n/strings'
import DetailPane from './DetailPane.astro'
import FilterBar from './FilterBar.astro'
import Icon from './Icon.astro'
import ItemEntry from './ItemEntry.astro'
import Provenance from './Provenance.astro'
import SkillEntry from './SkillEntry.astro'
import StateEntry from './StateEntry.astro'
import StatusBadge from './StatusBadge.astro'
import TermEntry from './TermEntry.astro'

type Props = {
  locale: Locale
  corpus: Corpus
  entries: BrowseEntry[]
  label: string
} & (
  | { variant: 'skills' | 'equipment' | 'rules' }
  | { variant: 'speciesSkills'; subspeciesLabel: string }
)

const { locale, corpus, entries, label, variant } = Astro.props
const t = strings(locale)
const sourcesLabel = variant === 'speciesSkills' ? t.alsoAvailable : t.provenance
const drafts = entries.filter((entry) => entry.status === 'draft').length
const filter =
  Astro.props.variant === 'speciesSkills'
    ? { variant: 'speciesSkills' as const, subspeciesLabel: Astro.props.subspeciesLabel }
    : { variant: Astro.props.variant }
---

<FilterBar locale={locale} total={entries.length} drafts={drafts} {...filter} />

<div
  data-browse={variant === 'speciesSkills' ? 'skills' : variant}
  data-selection="static"
  style="max-width:1560px; margin:0 auto; padding:0 26px 80px; display:flex; flex-wrap:wrap; gap:0 34px; align-items:flex-start"
>
  <div style="flex:1 1 420px; min-width:0; padding:8px 0 0">
    <ul
      data-rows
      data-no-swup
      aria-label={label}
      style="list-style:none; margin:0; padding:0; border-top:1px solid var(--accent-line)"
    >
      {
        entries.map((entry) => (
          <li {...entry.attrs} style="border-bottom:1px solid var(--line)">
            <a
              href={`#e-${entry.id}`}
              data-row
              style="display:grid; width:100%; grid-template-columns:3px minmax(0,1.6fr) minmax(0,1fr) auto; align-items:center; gap:14px; text-align:left"
            >
              <span data-row-mark aria-hidden="true" style={`background:${entry.mark}`} />
              <span style="min-width:0">
                <span style="display:block; font-family:var(--font-display); font-size:17px; font-weight:600; color:var(--ink); overflow:hidden; text-overflow:ellipsis; white-space:nowrap">
                  {entry.title}
                </span>
                <span style="display:flex; align-items:center; gap:8px; min-width:0; padding-top:4px">
                  {entry.status && (
                    <StatusBadge status={entry.status} locale={locale} size="sm" />
                  )}
                  <span style="min-width:0; font-family:var(--font-ui); font-size:13px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--ink3); overflow:hidden; text-overflow:ellipsis; white-space:nowrap">
                    {entry.sub}
                  </span>
                </span>
              </span>
              <span style="min-width:0; font-family:var(--font-mono); font-size:11px; color:var(--ink3); overflow:hidden; text-overflow:ellipsis; white-space:nowrap">
                {entry.aside}
              </span>
              <span style="display:inline-flex; align-items:center; gap:9px; font-family:var(--font-ui); font-weight:700; font-size:14px; color:var(--gold); font-variant-numeric:tabular-nums">
                {entry.coins.length > 0
                  ? entry.coins.map((part) => (
                      <span class="au-coin" style={`--coin:${part.color}`}>
                        <Icon name={part.iconName} class="au-coin__icon" />
                        <span class="au-coin__amount">{part.amount}</span>
                        <span>{part.name}</span>
                      </span>
                    ))
                  : entry.value}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <DetailPane label={t.detail}>
    {
      entries.map((entry) => (
        <article data-detail id={`e-${entry.id}`}>
          {entry.entity.kind === 'skill' && (
            <SkillEntry
              skill={entry.entity.skill}
              corpus={corpus}
              locale={locale}
              marks={false}
              priced={entry.entity.priced}
            />
          )}
          {entry.entity.kind === 'item' && (
            <ItemEntry item={entry.entity.item} corpus={corpus} locale={locale} />
          )}
          {entry.entity.kind === 'state' && (
            <StateEntry state={entry.entity.state} corpus={corpus} locale={locale} />
          )}
          {entry.entity.kind === 'term' && (
            <TermEntry term={entry.entity.term} corpus={corpus} locale={locale} />
          )}

          <Provenance
            entryId={entry.id}
            label={sourcesLabel}
            sources={entry.sources}
            corpus={corpus}
            locale={locale}
          />
        </article>
      ))
    }
  </DetailPane>
</div>

<style>
  [data-browse] > :global(.au-detail-pane) {
    flex: 1 1 370px;
    min-width: 0;
  }
  [data-row] {
    padding: 13px 8px 13px 0;
    scroll-margin-top: var(--sticky-top);
    transition:
      background-color 0.2s var(--ease),
      padding-left 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }
  [data-row-mark] {
    width: 3px;
    height: 22px;
    transition: height 0.2s var(--ease);
  }
  [data-row]:hover {
    background: var(--hover);
    padding-left: 7px;
  }
  [data-row][aria-current] {
    background: var(--bg3);
    padding-left: 7px;
    box-shadow: inset 2px 0 0 var(--gold);
  }
  [data-row][aria-current] [data-row-mark] {
    align-self: stretch;
    height: auto;
  }
  [data-detail] {
    display: none;
    scroll-margin-top: var(--sticky-top);
    animation: au-fade 0.22s var(--ease) both;
  }
  [data-selection='static'] [data-detail]:target {
    display: block;
  }
  [data-selection='static'] :global([data-details]):not(:has(:target)) [data-detail]:first-child {
    display: block;
  }
  [data-selection='enhanced'] [data-detail][data-current] {
    display: block;
  }
  [data-browse]:not(:has([data-entry]:not([hidden]))) :global([data-details]) {
    display: none;
  }
</style>
