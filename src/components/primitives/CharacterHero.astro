---
import { artKeyColour } from '../../lib/art-key-colour'
import type { CharacterSheet } from '../../lib/game/character-sheet'
import type { Locale } from '../../lib/i18n/locales'
import { strings } from '../../lib/i18n/strings'
import { KEY_FALLBACK } from '../../lib/key-colour'
import { stageSource } from '../../lib/stage-ambient'
import Banner from './Banner.astro'
import CoverSeal from './CoverSeal.astro'
import FramedCard from './FramedCard.astro'
import GhostName from './GhostName.astro'
import SheetBody from './SheetBody.astro'
import SheetHead from './SheetHead.astro'
import StageBackdrop from './StageBackdrop.astro'
import StillToggle from './StillToggle.astro'

type Props = {
  locale: Locale
  sheet: CharacterSheet
}

const { locale, sheet } = Astro.props
const t = strings(locale)

const CARD_WIDE = 'clamp(300px, min(36vw, calc((92vh - 120px) * 0.75)), 560px)'
const CARD_NARROW = 'min(calc(100vw - 32px), 520px)'
const WIDEST_ADVANCE = 0.78
const GHOST_SPAN = 70
const GHOST_LARGEST = 22
const NAME_SPAN = 100
const NAME_LARGEST = 40

const letters = Math.max(1, [...sheet.name].length)
const fitted = (column: number, largest: number) =>
  Math.min(largest, column / (WIDEST_ADVANCE * letters)).toFixed(2)
const key = sheet.keyColour ?? (sheet.cover ? await artKeyColour(sheet.cover) : KEY_FALLBACK)
const stage = [
  `--key:${key}`,
  `--ghost-size:${fitted(GHOST_SPAN, GHOST_LARGEST)}cqi`,
  `--name-fit:${fitted(NAME_SPAN, NAME_LARGEST)}cqi`,
].join('; ')
const sizes = `(min-width: 960px) ${CARD_WIDE}, ${CARD_NARROW}`
---

<section
  class="au-character au-dark"
  data-character
  data-stage-host
  data-tilt-host
  style={`${stage}; --card-wide:${CARD_WIDE}; --card-narrow:${CARD_NARROW}`}
>
  <StageBackdrop source={stageSource(sheet.cover, sheet.seal.colours)} />

  <div class="au-character__inner">
    <GhostName text={sheet.name} class="au-character__ghost" />

    <div class="au-character__info">
      <SheetHead locale={locale} sheet={sheet} heading="page" />
      <SheetBody locale={locale} sheet={sheet}>
        <slot />
      </SheetBody>
    </div>

    <FramedCard
      class="au-character__stage"
      emblem={sheet.emblem}
      data-tilt-card
      data-stage-focus
    >
      {
        sheet.cover ? (
          <Banner
            art={sheet.cover}
            objectPosition="50% 24%"
            plate="hero"
            effect={sheet.effect}
            motion="zoom-drift"
            seconds={24}
            settle={1}
            large
            priority
            sizes={sizes}
          />
        ) : (
          <CoverSeal name={sheet.name} seal={sheet.seal} />
        )
      }
    </FramedCard>
  </div>

  <StillToggle locale={locale} />

  <span aria-hidden="true" data-scroll-cue>
    {t.scrollCue}
    <svg
      width="16"
      height="9"
      viewBox="0 0 16 9"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="1,1 8,7.6 15,1"></polyline>
    </svg>
  </span>
</section>

<style>
  .au-character {
    --gold: var(--key);
    --motion-state: running;
    --card: var(--card-narrow);
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    overflow: clip;
    container-type: inline-size;
    background: var(--bg);
    color: var(--ink);
    border-bottom: 1px solid var(--line2);
  }

  .au-character[data-still] {
    --motion-state: paused;
  }

  .au-character__inner {
    position: relative;
    flex: 1;
    display: grid;
    grid-template-areas:
      'card'
      'info';
    justify-items: center;
    width: 100%;
    max-width: 1560px;
    margin: 0 auto;
    padding: 30px 16px 64px;
    box-sizing: border-box;
  }

  .au-character__ghost {
    top: 10%;
    right: -3%;
  }

  .au-character__info {
    grid-area: info;
    position: relative;
    z-index: 2;
    width: 100%;
    min-width: 0;
    margin-top: 30px;
    container-type: inline-size;
  }

  .au-character__stage {
    grid-area: card;
    z-index: 1;
    width: var(--card);
  }

  [data-scroll-cue] {
    position: sticky;
    bottom: 20px;
    z-index: 2;
    align-self: center;
    max-width: 100%;
    margin-bottom: 20px;
    padding: 0 26px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.3em;
    text-align: center;
    text-transform: uppercase;
    color: var(--ink2);
  }

  [data-scroll-cue] > svg {
    display: block;
    animation: au-nudge 2.4s cubic-bezier(0.37, 0, 0.63, 1) infinite;
  }

  @media (max-width: 639px) {
    [data-scroll-cue] {
      display: none;
    }
  }

  @media (min-width: 960px) {
    .au-character {
      --card: var(--card-wide);
      --name-largest: 132px;
      min-height: min(92vh, 900px);
    }

    .au-character__inner {
      grid-template-areas: 'info card';
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      justify-items: stretch;
      column-gap: clamp(36px, 5cqi, 104px);
      padding: 44px 26px 76px;
    }

    .au-character__ghost {
      top: auto;
      bottom: 9%;
      right: -2%;
    }

    .au-character__info {
      margin-top: 0;
    }

    .au-character__stage {
      margin-right: clamp(8px, 3cqi, 64px);
    }
  }

  @media (scripting: none) {
    .au-character {
      --motion-state: paused;
    }
  }

  @media print {
    .au-character {
      --ink: #14100a;
      --ink2: #3a3448;
      --gold: #7a5d10;
      min-height: 0;
      background: none;
    }

    [data-scroll-cue] {
      display: none;
    }
  }
</style>
