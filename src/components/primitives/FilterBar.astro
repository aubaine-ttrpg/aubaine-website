---
import Island, { type FilterGroup, type FilterKind } from '../../islands/FilterBar'
import type { Locale } from '../../lib/i18n/locales'
import { strings } from '../../lib/i18n/strings'

type Props = {
  locale: Locale
  variant: 'trees' | 'species' | 'skills' | 'speciesSkills' | 'equipment' | 'baseActions' | 'states'
  total: number
  drafts: number
}

const { locale, variant, total, drafts } = Astro.props
const t = strings(locale)

const GROUPS: Record<Props['variant'], FilterGroup[]> = {
  trees: [
    { key: 'tdom', label: t.domains },
    { key: 'tchar', label: t.primeChar },
    { key: 'sta', label: t.status_ },
  ],
  species: [{ key: 'sta', label: t.status_ }],
  skills: [
    { key: 'acq', label: t.provenance },
    { key: 'dom', label: t.domain_ },
    { key: 'typ', label: t.type_ },
    { key: 'cost', label: t.cost_ },
    { key: 'act', label: t.activation },
    { key: 'chr', label: t.characteristic_ },
    { key: 'tier', label: t.tier_ },
    { key: 'pra', label: t.tagPractice },
    { key: 'sch', label: t.tagSchool },
    { key: 'spe', label: t.tagSpecial },
    { key: 'sta', label: t.status_ },
  ],
  speciesSkills: [
    { key: 'sub', label: t.subspecies_ },
    { key: 'dom', label: t.domain_ },
    { key: 'typ', label: t.type_ },
    { key: 'cost', label: t.cost_ },
    { key: 'act', label: t.activation },
    { key: 'chr', label: t.characteristic_ },
    { key: 'tier', label: t.tier_ },
    { key: 'pra', label: t.tagPractice },
    { key: 'sch', label: t.tagSchool },
    { key: 'spe', label: t.tagSpecial },
    { key: 'sta', label: t.status_ },
  ],
  equipment: [
    { key: 'cat', label: t.category },
    { key: 'rar', label: t.rarity_ },
    { key: 'craft', label: t.craft },
    { key: 'stat', label: t.stat_ },
    { key: 'prop', label: t.property_ },
    { key: 'set', label: t.set_ },
    { key: 'sta', label: t.status_ },
  ],
  baseActions: [{ key: 'act', label: t.activation }],
  states: [{ key: 'eff', label: t.effect_ }],
}

const kinds: FilterKind[] | undefined =
  variant === 'trees'
    ? [
        { key: 'all', label: t.allTrees, dot: 'var(--gold)' },
        { key: 'archetype', label: t.archetypes, dot: 'var(--ink3)' },
        { key: 'domain', label: t.domains, dot: 'var(--ink3)' },
      ]
    : undefined

const islandStrings = {
  filterHere: t.filterHere,
  filters: t.filters,
  byName: t.byName,
  clear: t.clear,
  close: t.close,
  apply: t.apply,
  resetFilters: t.resetFilters,
  result: t.result,
  results: t.results,
  emptyTitle: t.emptyTitle,
  emptyBody: t.emptyBody,
  treeKind: t.treeKind,
  allTrees: t.allTrees,
  drafts: t.drafts,
  emptyListTitle: t.emptyListTitle,
  emptyListBody: t.emptyListBody,
}
---

<Island
  client:idle
  strings={islandStrings}
  groups={GROUPS[variant]}
  kinds={kinds}
  total={total}
  drafts={drafts}
  locale={locale}
  inputMaxWidth={variant === 'trees' ? '300px' : '340px'}
/>

<style is:global>
  .au-drafts-switch {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .au-switch {
    appearance: none;
    position: relative;
    flex: none;
    width: 36px;
    height: 20px;
    margin: 0;
    border: 1px solid var(--ink3);
    border-radius: 999px;
    background: var(--field);
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .au-switch::before {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--ink3);
    transition:
      transform 0.18s var(--ease),
      background-color 0.2s var(--ease);
  }

  .au-switch:checked,
  :root[data-drafts='shown'] .au-switch {
    border-color: var(--gold);
    background: var(--accent-soft);
  }

  .au-switch:checked::before,
  :root[data-drafts='shown'] .au-switch::before {
    transform: translateX(16px);
    background: var(--gold);
  }

  .au-switch:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .au-switch,
    .au-switch::before {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .au-switch {
      border-color: CanvasText;
    }

    .au-switch::before {
      background: CanvasText;
    }

    .au-switch:checked::before {
      background: Highlight;
    }
  }
</style>
