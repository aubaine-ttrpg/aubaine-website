---
import Island, {
  type FilterGroup,
  type FilterKind,
  type UnmatchedEntries,
} from '../../islands/FilterBar'
import type { Locale } from '../../lib/i18n/locales'
import { strings } from '../../lib/i18n/strings'
import EmptyState from './EmptyState.astro'

type ListVariant =
  | 'trees'
  | 'species'
  | 'skills'
  | 'treeNodes'
  | 'equipment'
  | 'materials'
  | 'rules'
  | 'library'

type Props = {
  locale: Locale
  total: number
  drafts: number
} & ({ variant: ListVariant } | { variant: 'speciesSkills'; subspeciesLabel: string })

const { locale, variant, total, drafts } = Astro.props
const t = strings(locale)

const SKILL_FACETS: FilterGroup[] = [
  { key: 'dom', label: t.domain_ },
  { key: 'typ', label: t.type_ },
  { key: 'cost', label: t.cost_ },
  { key: 'act', label: t.activation },
  { key: 'chr', label: t.characteristic_ },
  { key: 'tier', label: t.tier_ },
  { key: 'pra', label: t.tagPractice },
  { key: 'sch', label: t.tagSchool },
  { key: 'spe', label: t.tagSpecial },
]
const STATUS_FACET: FilterGroup = { key: 'sta', label: t.status_ }

const GROUPS: Record<ListVariant, FilterGroup[]> = {
  trees: [
    { key: 'tdom', label: t.domains },
    { key: 'tchar', label: t.primeChar },
    { key: 'sta', label: t.status_ },
  ],
  species: [{ key: 'sta', label: t.status_ }],
  library: [{ key: 'sta', label: t.status_ }],
  skills: [{ key: 'acq', label: t.provenance }, ...SKILL_FACETS, STATUS_FACET],
  treeNodes: SKILL_FACETS,
  equipment: [
    { key: 'cat', label: t.category },
    { key: 'rar', label: t.rarity_ },
    { key: 'craft', label: t.craft },
    { key: 'stat', label: t.stat_ },
    { key: 'prop', label: t.property_ },
    { key: 'set', label: t.set_ },
    { key: 'sta', label: t.status_ },
  ],
  materials: [
    { key: 'fam', label: t.family_ },
    { key: 'mtyp', label: t.materialType_ },
    { key: 'env', label: t.environment },
    { key: 'val', label: t.materialValue },
    { key: 'sta', label: t.status_ },
  ],
  rules: [
    { key: 'fam', label: t.family_ },
    { key: 'eff', label: t.effect_ },
    { key: 'styp', label: t.stateType_ },
  ],
}

const groups: FilterGroup[] =
  Astro.props.variant === 'speciesSkills'
    ? [{ key: 'sub', label: Astro.props.subspeciesLabel }, ...SKILL_FACETS, STATUS_FACET]
    : GROUPS[Astro.props.variant]

const unmatched: UnmatchedEntries = variant === 'treeNodes' ? 'dimmed' : 'hidden'

const kinds: FilterKind[] | undefined =
  variant === 'trees'
    ? [
        { key: 'all', label: t.allTrees, dot: 'var(--gold)' },
        { key: 'archetype', label: t.archetypes, dot: 'var(--ink3)' },
        { key: 'domain', label: t.domains, dot: 'var(--ink3)' },
      ]
    : undefined

const islandStrings = {
  filterHere: t.filterHere,
  filters: t.filters,
  byName: t.byName,
  clear: t.clear,
  close: t.close,
  apply: t.apply,
  resetFilters: t.resetFilters,
  result: t.result,
  results: t.results,
  treeKind: t.treeKind,
  allTrees: t.allTrees,
  hideDrafts: t.hideDrafts,
}
---

<Island
  client:idle
  strings={islandStrings}
  groups={groups}
  kinds={kinds}
  total={total}
  drafts={drafts}
  locale={locale}
  unmatched={unmatched}
  inputMaxWidth={variant === 'trees' ? '300px' : '340px'}
/>

<div class="au-filter-empty" data-filter-empty="unpublished" hidden>
  <EmptyState title={t.emptyListTitle} body={t.emptyListBody} />
</div>
<div class="au-filter-empty" data-filter-empty="filtered" hidden>
  <EmptyState title={t.emptyTitle} body={t.emptyBody}>
    <button type="button" class="au-filter-reset" data-filter-reset>{t.resetFilters}</button>
  </EmptyState>
</div>

<style>
  .au-filter-empty {
    box-sizing: border-box;
    max-width: 1560px;
    min-height: min(56vh, 34rem);
    margin: 0 auto;
    padding: 46px 26px;
  }

  .au-filter-empty:not([hidden]) {
    display: grid;
    place-items: center;
  }

  .au-filter-reset {
    padding: 9px 15px;
    border: 1px solid var(--line2);
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    transition: border-color 0.2s var(--ease);
  }

  .au-filter-reset:hover,
  .au-filter-reset:focus-visible {
    border-color: var(--gold);
  }
</style>

<style is:global>
  .au-filterbar {
    box-sizing: border-box;
    max-width: 1560px;
    margin: 0 auto;
    padding: 22px 26px 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    border-bottom: 1px solid var(--line2);
  }

  .au-filterbar__field {
    border: 1px solid var(--line2);
    background: var(--field);
    color: var(--ink);
    font-family: var(--font-ui);
    transition: border-color 0.2s var(--ease);
  }

  .au-filterbar__field:hover,
  .au-filterbar__field:focus-visible {
    border-color: var(--gold);
  }

  .au-filterbar__kind {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    cursor: pointer;
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .au-filterbar__search {
    flex: 1;
    min-width: 0;
    padding: 10px 13px;
    outline: none;
    font-size: 15px;
  }

  .au-filterbar__tools {
    flex: 0 1 auto;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 12px 16px;
  }

  .au-filterbar__count,
  .au-filterbar__tape {
    margin: 0;
    padding: 5px 9px 4px;
    rotate: -2deg;
    background: #08070d;
    color: color-mix(in srgb, var(--gold) 55%, #fff);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.45);
  }

  .au-filterbar__tape {
    font-size: 10px;
    letter-spacing: 0.2em;
  }

  .au-filterbar__open,
  .au-filterbar__apply {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 10px 16px;
    border: none;
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 14.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-gold);
    background: var(--gold);
    box-shadow: 4px 4px 0 rgba(6, 5, 13, 0.6);
    transition:
      translate 0.18s var(--ease),
      box-shadow 0.18s var(--ease);
  }

  .au-filterbar__open:hover,
  .au-filterbar__apply:hover {
    translate: -1px -1px;
    box-shadow: 6px 6px 0 rgba(6, 5, 13, 0.6);
  }

  .au-filterbar__open:focus-visible,
  .au-filterbar__apply:focus-visible,
  .au-filterbar__chip:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  .au-filterbar__active {
    padding: 1px 7px;
    background: #08070d;
    color: var(--gold);
    font-family: var(--font-mono);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
  }

  .au-filterbar__modal {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 24px;
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: visible;
  }

  .au-filterbar__modal[open] {
    display: grid;
    place-items: center;
  }

  .au-filterbar__modal::backdrop {
    background: transparent;
  }

  .au-filterbar__scrim {
    position: absolute;
    inset: 0;
    background: rgba(4, 3, 10, 0.72);
    backdrop-filter: blur(6px);
    pointer-events: none;
  }

  .au-filterbar__dialog {
    position: relative;
    width: min(560px, 100%);
    max-height: 82dvh;
    overflow-x: clip;
    overflow-y: auto;
    border: 1px solid var(--gold);
    background: var(--bg2);
    box-shadow: 10px 12px 0 rgba(6, 5, 13, 0.6);
  }

  .au-filterbar__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--ink);
  }

  .au-filterbar__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px 6px;
    border: 1px solid var(--line2);
    background: transparent;
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 14.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink2);
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease),
      rotate 0.2s var(--ease);
  }

  .au-filterbar__chip:hover {
    border-color: var(--gold);
    color: var(--ink);
  }

  .au-filterbar__chip[aria-pressed='true'] {
    rotate: -1.5deg;
    border-color: var(--gold);
    background: var(--gold);
    color: var(--on-gold);
    box-shadow: 3px 3px 0 rgba(6, 5, 13, 0.6);
  }

  .au-filterbar__chip-count {
    font-family: var(--font-mono);
    font-size: 10px;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  @media (forced-colors: active) {
    .au-filterbar__count,
    .au-filterbar__tape,
    .au-filterbar__chip[aria-pressed='true'] {
      rotate: none;
    }
  }

  .au-drafts-switch {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .au-switch {
    appearance: none;
    position: relative;
    flex: none;
    width: 36px;
    height: 20px;
    margin: 0;
    border: 1px solid var(--ink3);
    border-radius: 999px;
    background: var(--field);
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .au-switch::before {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--ink3);
    transition:
      transform 0.18s var(--ease),
      background-color 0.2s var(--ease);
  }

  .au-switch:checked,
  :root[data-drafts='hidden'] .au-switch {
    border-color: var(--gold);
    background: var(--accent-soft);
  }

  .au-switch:checked::before,
  :root[data-drafts='hidden'] .au-switch::before {
    transform: translateX(16px);
    background: var(--gold);
  }

  .au-switch:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .au-switch,
    .au-switch::before {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .au-switch {
      border-color: CanvasText;
    }

    .au-switch::before {
      background: CanvasText;
    }

    .au-switch:checked::before {
      background: Highlight;
    }
  }

  @media print {
    .au-filterbar__active {
      background: none;
      color: var(--on-gold);
    }
  }
</style>
