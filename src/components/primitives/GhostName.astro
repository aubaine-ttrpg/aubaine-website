---
type Props = { text: string; class?: string }

const { text, class: className, ...rest } = Astro.props
---

<p class:list={['au-ghost', className]} aria-hidden="true" {...rest}>{text}</p>

<style>
  .au-ghost {
    position: absolute;
    z-index: 0;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--ghost-size);
    font-weight: 700;
    line-height: 0.8;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--gold) 34%, transparent);
    mask-image: linear-gradient(90deg, transparent 0%, #000 38%);
    pointer-events: none;
    user-select: none;
    animation: au-ghost-drift 32s ease-in-out infinite alternate;
    animation-play-state: var(--motion-state, running);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .au-ghost {
      translate: calc(var(--lean-x, 0) * -22px) 0;
      transition: translate 0.6s var(--ease);
    }
  }

  @media (forced-colors: active) {
    .au-ghost {
      display: none;
    }
  }

  @media print {
    .au-ghost {
      display: none;
    }
  }

  @keyframes au-ghost-drift {
    from {
      margin-right: 0;
    }
    to {
      margin-right: 4cqi;
    }
  }
</style>
