---
import { artImage } from '../../lib/media'
import Banner from './Banner.astro'

type Layout = 'banner' | 'portrait'

type Props = {
  art?: string | undefined
  layout?: Layout
  objectPosition?: string
  motion?: 'none' | 'drift' | 'zoom-drift' | 'burns'
  seconds?: number
  settle?: number
  large?: boolean
  priority?: boolean
  minHeight: string
  bottomStops: [number, number]
  sideStops: [number, number]
  padding: string
  scrollCue?: string | undefined
}

const {
  art,
  layout = 'banner',
  objectPosition = '50% 26%',
  motion = 'drift',
  seconds = 22,
  settle = 2.2,
  large = false,
  priority = false,
  minHeight,
  bottomStops,
  sideStops,
  padding,
  scrollCue,
} = Astro.props

const PORTRAIT_POSITION = '50% 24%'
const PANEL_SPAN = 'min(100vw, 1560px)'

const image = artImage(art)
const aspect = image ? Math.round((image.width / image.height) * 10000) / 10000 : 16 / 9
const coverWidth = `calc(${minHeight} * ${aspect})`
const sizes =
  layout === 'portrait'
    ? `(min-width: 960px) clamp(calc(${PANEL_SPAN} * 0.42), ${coverWidth}, calc(${PANEL_SPAN} * 0.55)), max(100vw, ${coverWidth})`
    : `max(100vw, ${coverWidth})`

const scrims = [
  `background:linear-gradient(0deg, var(--scrim1) 0%, var(--scrim-mid) ${bottomStops[0]}%, var(--scrim2) ${bottomStops[1]}%)`,
  `background:linear-gradient(90deg, var(--scrim-side) 0%, var(--scrim-mid) ${sideStops[0]}%, var(--scrim2) ${sideStops[1]}%)`,
]
const plate = { motion, seconds, settle, large, priority, sizes }
---

<section
  class="au-hero"
  data-layout={layout}
  style={`--hero-min:${minHeight}; min-height:${minHeight}`}
>
  {
    layout === 'banner' && (
      <div class="au-hero__banner">
        <Banner art={art} objectPosition={objectPosition} {...plate} />
        {scrims.map((scrim) => (
          <span aria-hidden="true" class="au-hero__scrim" style={scrim} />
        ))}
      </div>
    )
  }
  {
    layout === 'portrait' && (
      <div class="au-hero__portrait">
        <Banner art={art} objectPosition={PORTRAIT_POSITION} {...plate} />
        {scrims.map((scrim) => (
          <span aria-hidden="true" class="au-hero__scrim au-hero__scrim--narrow" style={scrim} />
        ))}
      </div>
    )
  }
  <div class="au-hero__stage">
    <div class="au-hero__content" style={`padding:${padding}`}>
      <div class="au-hero__column">
        {
          Astro.slots.has('plates') && (
            <div class="au-hero__plates">
              <slot name="plates" />
            </div>
          )
        }
        <slot />
      </div>
    </div>
  </div>
  {
    scrollCue && (
      <span aria-hidden="true" data-scroll-cue>
        {scrollCue}
        <svg
          width="16"
          height="9"
          viewBox="0 0 16 9"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="display:block; animation:au-nudge 2.4s cubic-bezier(.37,0,.63,1) infinite"
        >
          <polyline points="1,1 8,7.6 15,1" />
        </svg>
      </span>
    )
  }
</section>

<style>
  .au-hero {
    --hero-ink: var(--art-ink);
    --hero-ink2: var(--art-ink2);
    --hero-span: min(100vw, 1560px);
    --hero-panel: clamp(calc(var(--hero-span) * 0.42), calc(var(--hero-min) * 0.75), calc(var(--hero-span) * 0.55));
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: clip;
    border-bottom: 1px solid var(--line2);
  }

  .au-hero__banner,
  .au-hero__portrait,
  .au-hero__scrim {
    position: absolute;
    inset: 0;
  }

  .au-hero__portrait {
    overflow: clip;
  }

  .au-hero__stage {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    max-width: 1560px;
    margin: 0 auto;
  }

  .au-hero__content {
    width: 100%;
  }

  .au-hero__plates {
    position: absolute;
    top: 26px;
    right: 26px;
    z-index: 3;
    pointer-events: none;
  }

  @media (min-width: 960px) {
    .au-hero[data-layout='portrait'] {
      --hero-ink: var(--ink);
      --hero-ink2: var(--ink2);
    }

    .au-hero[data-layout='portrait'] .au-hero__portrait {
      left: auto;
      right: max(0px, calc((100% - 1560px) / 2));
      width: var(--hero-panel);
      mask-image: linear-gradient(90deg, transparent 0%, #000 38%);
    }

    .au-hero[data-layout='portrait'] .au-hero__scrim--narrow {
      display: none;
    }

    .au-hero[data-layout='portrait'] .au-hero__column {
      max-width: calc(100% - var(--hero-panel) * 0.82);
    }

    .au-hero[data-layout='portrait'] .au-hero__plates {
      right: auto;
      left: 26px;
    }
  }

  @media (min-width: 1561px) {
    .au-hero[data-layout='portrait'] .au-hero__portrait {
      mask-image: linear-gradient(90deg, transparent 0%, #000 38%, #000 90%, transparent 100%);
    }
  }

  [data-scroll-cue] {
    position: sticky;
    bottom: 20px;
    align-self: center;
    max-width: 100%;
    margin-bottom: 20px;
    padding: 0 26px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.3em;
    text-align: center;
    text-transform: uppercase;
    color: var(--hero-ink2);
  }

  @media (max-width: 639px) {
    [data-scroll-cue] {
      display: none;
    }
  }
</style>
