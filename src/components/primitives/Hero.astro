---
import { artImage } from '../../lib/media'
import Banner from './Banner.astro'

type Props = {
  art?: string | undefined
  objectPosition?: string
  motion?: 'none' | 'drift' | 'zoom-drift' | 'burns'
  seconds?: number
  settle?: number
  large?: boolean
  priority?: boolean
  minHeight: string
  bottomStops: [number, number]
  sideStops: [number, number]
  padding: string
}

const {
  art,
  objectPosition = '50% 26%',
  motion = 'drift',
  seconds = 22,
  settle = 2.2,
  large = false,
  priority = false,
  minHeight,
  bottomStops,
  sideStops,
  padding,
} = Astro.props

const image = artImage(art)
const aspect = image ? Math.round((image.width / image.height) * 10000) / 10000 : 16 / 9
const sizes = `max(100vw, calc(${minHeight} * ${aspect}))`

const scrims = [
  `background:linear-gradient(0deg, var(--scrim1) 0%, var(--scrim-mid) ${bottomStops[0]}%, var(--scrim2) ${bottomStops[1]}%)`,
  `background:linear-gradient(90deg, var(--scrim-side) 0%, var(--scrim-mid) ${sideStops[0]}%, var(--scrim2) ${sideStops[1]}%)`,
]
---

<section class="au-hero" style={`min-height:${minHeight}`}>
  <div class="au-hero__banner">
    <Banner
      art={art}
      objectPosition={objectPosition}
      motion={motion}
      seconds={seconds}
      settle={settle}
      large={large}
      priority={priority}
      sizes={sizes}
    />
    {scrims.map((scrim) => <span aria-hidden="true" class="au-hero__scrim" style={scrim} />)}
  </div>
  <div class="au-hero__stage">
    <div class="au-hero__content" style={`padding:${padding}`}>
      <slot />
    </div>
  </div>
</section>

<style>
  .au-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: clip;
    border-bottom: 1px solid var(--line2);
  }

  .au-hero__banner,
  .au-hero__scrim {
    position: absolute;
    inset: 0;
  }

  .au-hero__stage {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    max-width: 1560px;
    margin: 0 auto;
  }

  .au-hero__content {
    width: 100%;
  }
</style>
