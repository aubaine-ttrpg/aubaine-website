---
import { headFit } from '../../lib/game/book-markup'
import type { TitlePictogram } from '../../lib/title-frames'
import GhostName from './GhostName.astro'
import TitleFrame from './TitleFrame.astro'

type Chapter = { number: string; pictogram: TitlePictogram }

type Props = {
  text: string
  line?: string | undefined
  chapter?: Chapter | undefined
  headingData?: Record<`data-${string}`, string> | undefined
}

const { text, line, chapter, headingData } = Astro.props
---

<div class="au-title" data-look={chapter ? 'chapter' : 'page'} style={headFit(text)}>
  <TitleFrame pictogram={chapter?.pictogram} size={chapter ? 'chapter' : 'page'} />
  {chapter && <GhostName text={chapter.number} class="au-title__ghost" />}
  <div class="au-title__plate">
    <h1 {...headingData}>{text}</h1>
  </div>
</div>
{line && <p class="au-title__line">{line}</p>}
