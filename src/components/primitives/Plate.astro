---
import { treeNodeAttributes } from '../../lib/game/browse-entries'
import type { Corpus, ResolvedTree } from '../../lib/game/corpus'
import { formatNumber, frame, showsXp, treeTypeLabel, xpOf } from '../../lib/game/derive'
import type { Locale } from '../../lib/i18n/locales'
import { treeNodeHref } from '../../lib/i18n/routes'
import { strings } from '../../lib/i18n/strings'
import NodeShape from './NodeShape.astro'
import PlateLegend from './PlateLegend.astro'

type Props = { locale: Locale; corpus: Corpus; tree: ResolvedTree } & (
  | { variant: 'sheet' }
  | { variant: 'board'; selected: string | undefined }
)

type LitEnd = 'start' | 'end'

const { locale, corpus, tree } = Astro.props
const board = Astro.props.variant === 'board'
const selected = Astro.props.variant === 'board' ? Astro.props.selected : undefined
const t = strings(locale)

const VIEW_W = 960
const VIEW_H = 1358
const CORE_DEFAULT = { x: 50, y: 50.81 }
const ORBIT_CENTER = { x: 480, y: 690 }
const ORBITS = [175, 335, 500]
const NODE_REACH = { above: 52, below: 100 }
const BOARD_MARGIN = 16

const colorOf = (key: string): string => corpus.domains.get(key)?.color ?? '#2a2a2e'
const corePos = tree.core?.pos ?? CORE_DEFAULT
const toPlateX = (percent: number): number => percent * (VIEW_W / 100)
const toPlateY = (percent: number): number => percent * (VIEW_H / 100)

const positions = new Map<string, { x: number; y: number }>()
for (const placement of tree.placements) {
  if (placement.pos) positions.set(placement.skill.id, placement.pos)
}

const litEnd = (from: string, to: string): LitEnd | undefined => {
  if (selected === from) return 'start'
  if (selected === to) return 'end'
  return undefined
}

const edges: {
  x1: string
  y1: string
  x2: string
  y2: string
  ends: string
  lit: LitEnd | undefined
}[] = []
for (const placement of tree.placements) {
  const from = positions.get(placement.skill.id)
  for (const target of placement.linked ?? []) {
    const to = target === 'CORE' ? corePos : positions.get(target)
    if (!from || !to) continue
    edges.push({
      x1: toPlateX(from.x).toFixed(1),
      y1: toPlateY(from.y).toFixed(1),
      x2: toPlateX(to.x).toFixed(1),
      y2: toPlateY(to.y).toFixed(1),
      ends: `${placement.skill.id} ${target}`,
      lit: litEnd(placement.skill.id, target),
    })
  }
}

const treeTypeLabels = { archetypes: t.archetype, domains: t.domain, species: t.species }
const plateSub = `${treeTypeLabel(tree.treeType, treeTypeLabels)} · ${t.plate}`

const distanceFromCentre = (pos: { x: number; y: number }): number =>
  Math.hypot(toPlateX(pos.x) - ORBIT_CENTER.x, toPlateY(pos.y) - ORBIT_CENTER.y)

const hintOrder = new Map(
  [...positions.entries()]
    .sort(([, a], [, b]) => distanceFromCentre(a) - distanceFromCentre(b))
    .map(([id], rank) => [id, rank] as const),
)

const nodes = tree.placements
  .filter((placement) => placement.pos !== undefined)
  .map((placement) => ({
    skill: placement.skill,
    left: `${placement.pos?.x ?? 50}%`,
    top: `${placement.pos?.y ?? 50}%`,
    selected: selected === placement.skill.id,
    hint: hintOrder.get(placement.skill.id) ?? 0,
  }))

const outerOrbit = Math.max(...ORBITS)
const nodeYs = [...positions.values()].map((pos) => toPlateY(pos.y))
const boardLeft = Math.floor(ORBIT_CENTER.x - outerOrbit - BOARD_MARGIN)
const boardRight = Math.ceil(ORBIT_CENTER.x + outerOrbit + BOARD_MARGIN)
const boardTop = Math.floor(
  Math.min(ORBIT_CENTER.y - outerOrbit, ...nodeYs.map((y) => y - NODE_REACH.above)) - BOARD_MARGIN,
)
const boardBottom = Math.ceil(
  Math.max(ORBIT_CENTER.y + outerOrbit, ...nodeYs.map((y) => y + NODE_REACH.below)) + BOARD_MARGIN,
)
const boardFrame = [
  `--board-left:${boardLeft}`,
  `--board-top:${boardTop}`,
  `--board-width:${boardRight - boardLeft}`,
  `--board-height:${boardBottom - boardTop}`,
].join('; ')
---

<div
  class={board ? 'au-sheet au-sheet--board' : 'au-sheet'}
  role={board ? 'group' : undefined}
  aria-label={t.plateLabel}
  style={board ? boardFrame : undefined}
  data-plate-viewer={board ? '' : undefined}
  data-heart-x={board ? toPlateX(corePos.x).toFixed(1) : undefined}
  data-heart-y={board ? toPlateY(corePos.y).toFixed(1) : undefined}
>
  {
    board && (
      <div class="au-viewer" data-viewer-controls hidden>
        <button
          type="button"
          class="au-viewer__button"
          data-view-zoom="in"
          aria-label={t.zoomIn}
          title={t.zoomIn}
        >
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 3v10M3 8h10" />
          </svg>
        </button>
        <button
          type="button"
          class="au-viewer__button"
          data-view-zoom="out"
          aria-label={t.zoomOut}
          title={t.zoomOut}
        >
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3 8h10" />
          </svg>
        </button>
        <button
          type="button"
          class="au-viewer__button"
          data-view-zoom="fit"
          aria-label={t.zoomFit}
          title={t.zoomFit}
        >
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M2.5 6V2.5H6M10 2.5h3.5V6M13.5 10v3.5H10M6 13.5H2.5V10" />
          </svg>
        </button>
      </div>
    )
  }
  <div class="au-plate">
    <svg
      class="au-plate__links"
      viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      {
        ORBITS.map((r) => (
          <circle class="au-plate__orbit" cx={ORBIT_CENTER.x} cy={ORBIT_CENTER.y} r={r} />
        ))
      }
      {
        edges.map((edge) => (
          <line
            class="au-plate__edge"
            x1={edge.x1}
            y1={edge.y1}
            x2={edge.x2}
            y2={edge.y2}
            pathLength={board ? 1 : undefined}
            data-ends={board ? edge.ends : undefined}
            data-lit={edge.lit}
          />
        ))
      }
    </svg>

    {
      !board && (
        <header class="au-plate__head">
          <span class="au-plate__title">{tree.name}</span>
          <span class="au-plate__sub">{plateSub}</span>
        </header>
      )
    }

    {
      tree.core && (
        <div
          class="au-core"
          style={`left:${corePos.x}%; top:${corePos.y}%; --domain:${frame((tree.core.domains ?? []).map(colorOf))}`}
        >
          <span class="au-core__ring" />
          <span class="au-core__glyph" />
          <span class="au-core__plate">
            <span class="au-core__label">{tree.core.label}</span>
            <span class="au-core__sub">
              {tree.core.sublabel ?? treeTypeLabel(tree.treeType, treeTypeLabels)}
            </span>
          </span>
        </div>
      )
    }

    {
      nodes.map((node) =>
        board ? (
          <a
            class="au-node"
            href={treeNodeHref(locale, tree.id, node.skill.id)}
            data-plate-node
            data-node={node.skill.id}
            {...treeNodeAttributes(node.skill, corpus, locale)}
            aria-current={node.selected ? 'page' : undefined}
            style={`left:${node.left}; top:${node.top}; --hint-order:${node.hint}`}
          >
            <NodeShape skill={node.skill} corpus={corpus} variant="tree" />
            <span class="au-nameplate">
              {showsXp(node.skill) && (
                <span class="au-nameplate__xp">{formatNumber(xpOf(node.skill), locale)}</span>
              )}
              <span class="au-nameplate__title">{node.skill.title}</span>
            </span>
          </a>
        ) : (
          <div class="au-node" style={`left:${node.left}; top:${node.top}`}>
            <NodeShape skill={node.skill} corpus={corpus} variant="tree" />
            <span class="au-nameplate">
              {showsXp(node.skill) && (
                <span class="au-nameplate__xp">{formatNumber(xpOf(node.skill), locale)}</span>
              )}
              <span class="au-nameplate__title">{node.skill.title}</span>
            </span>
          </div>
        ),
      )
    }

    {!board && <PlateLegend class="au-legend" locale={locale} corpus={corpus} tree={tree} />}

    {
      !board && (
        <footer class="au-plate__foot">
          <span>{`Aubaine · ${tree.name}`}</span>
          <span>aubaine.io</span>
          <span data-page-number />
        </footer>
      )
    }
  </div>
</div>
