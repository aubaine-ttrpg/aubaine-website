---
import { doorContract, type HubDoor } from '../../lib/game/hub-doors'
import { platesOf } from '../../lib/plates'
import type { StageLook } from '../../lib/stage-ambient'
import DoorGlyph from './DoorGlyph.astro'
import Icon from './Icon.astro'

type Props = { door: HubDoor; look: StageLook; index: number; lit: boolean }

const { door, look, index, lit } = Astro.props

const TILTS = ['-1deg', '0.7deg', '-0.5deg', '0.9deg'] as const

const plates = platesOf(door.name).map((plate, at) => ({
  ...plate,
  tilt: TILTS[(index + at) % TILTS.length],
}))
const contract = doorContract(door, look, index, lit)
const { nameId, lineId } = contract
---

<li
  class="au-plate-door"
  data-door
  data-lit={contract.lit}
  data-door-art={contract.art}
  data-door-backdrop={contract.backdrop}
  data-door-soft={contract.soft}
  data-door-colours={contract.colours}
  style={contract.style}
>
  <span class="au-plate-door__scene" aria-hidden="true">
    <span class="au-plate-door__band"></span>
    <span class="au-plate-door__giant">
      <DoorGlyph icon={door.mark.icon} />
    </span>
  </span>
  <a class="au-plate-door__link" href={door.href} aria-labelledby={nameId} aria-describedby={lineId}>
    <span class="au-plate-door__mark" aria-hidden="true">
      <svg class="au-plate-door__hex" viewBox="0 0 100 100" focusable="false">
        <polygon points="50,4 90,27 90,73 50,96 10,73 10,27"></polygon>
      </svg>
      <Icon name={door.mark.icon} class="au-plate-door__glyph" />
    </span>
    <span class="au-plate-door__namebox">
      <span
        class="au-plate-door__name"
        id={nameId}
        data-door-focus
        data-stage-focus={contract.lit}
      >
        <span class="au-plate-door__slab" aria-hidden="true"></span>
        {
          plates.map((plate, at) => (
            <>
              <span
                class:list={['au-plate-door__plate', { 'au-plate-door__plate--small': plate.small }]}
                style={`--tilt:${plate.tilt}`}
              >
                {plate.word}
              </span>
              {at < plates.length - 1 && ' '}
            </>
          ))
        }
      </span>
    </span>
    <span class="au-plate-door__line" id={lineId}>{door.tagline}</span>
  </a>
</li>

<style>
  .au-plate-door__scene {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: clip;
    pointer-events: none;
    opacity: var(--lit);
    transition: opacity 0.18s var(--ease);
  }

  .au-plate-door__band {
    position: absolute;
    top: 48px;
    right: -4vw;
    bottom: 56px;
    width: 46vw;
    rotate: -6deg;
    clip-path: polygon(16% 0, 100% 5%, 86% 100%, 0 94%);
    background: color-mix(in srgb, var(--door-colour) calc(52% + var(--pointed) * 30%), #0a0912);
    translate: calc((1 - var(--lit)) * 6%) 0;
    transition:
      translate 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.2s var(--ease);
  }

  .au-plate-door__band::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(6, 5, 13, 0.4) 0 2.2px, transparent 2.6px) 0 0 / 8px
      8px;
    -webkit-mask-image: linear-gradient(225deg, transparent 45%, #000 100%);
    mask-image: linear-gradient(225deg, transparent 45%, #000 100%);
  }

  .au-plate-door__giant {
    --giant: min(60vh, 520px, 36vw);
    position: absolute;
    top: 50%;
    left: calc(78vw - var(--giant) / 2);
    width: var(--giant);
    aspect-ratio: 1;
    translate: 0 -50%;
    rotate: calc(4deg - (1 - var(--lit)) * 6deg);
    scale: calc(1.12 - var(--lit) * 0.12);
    transition:
      rotate 0.24s cubic-bezier(0.2, 1.35, 0.4, 1),
      scale 0.24s cubic-bezier(0.2, 1.35, 0.4, 1);
  }

  .au-plate-door__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'mark name'
      '. line';
    align-items: center;
    gap: 8px var(--gap);
    padding: clamp(10px, 1.4vw, 18px) 0;
    color: inherit;
    text-decoration: none;
    outline-offset: 6px;
    scroll-margin-block: calc(var(--sticky-top) + 8px) 16px;
  }

  .au-plate-door__link:focus-visible {
    outline: 2px solid var(--door-ink);
  }

  .au-plate-door__mark {
    grid-area: mark;
    position: relative;
    display: grid;
    place-items: center;
    width: var(--mark-size);
    height: calc(var(--mark-size) * 1.08);
    animation: au-plate-door-strike 0.42s var(--ease-slap)
      calc(0.08s + min(var(--order), 5) * 0.03s) backwards;
  }

  .au-plate-door__hex {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(3px 4px 0 rgba(6, 5, 13, 0.6));
  }

  .au-plate-door__hex polygon {
    fill: color-mix(in srgb, var(--door-ink) calc(var(--lit) * 100%), #08070d);
    stroke: var(--door-ink);
    stroke-width: 4;
    transition: fill 0.2s var(--ease);
  }

  .au-plate-door__mark :global(.au-plate-door__glyph) {
    position: relative;
    width: 50%;
    height: 50%;
    color: color-mix(in srgb, var(--door-paper-ink) calc(var(--lit) * 100%), var(--door-ink));
    transition: color 0.2s var(--ease);
  }

  .au-plate-door__namebox {
    grid-area: name;
    min-width: 0;
    transition: translate 0.2s var(--ease);
  }

  .au-plate-door__link:is(:active, [data-pressed]) .au-plate-door__namebox {
    translate: 2px 3px;
    transition-duration: 0.05s;
  }

  .au-plate-door__name {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.06em 0.16em;
    max-width: var(--name-room);
    font-family: var(--font-display);
    font-size: var(--name-px);
    font-weight: 700;
    line-height: 0.86;
    text-transform: uppercase;
    translate: 0 calc(var(--pointed) * -6px);
    transition: translate 0.34s var(--ease);
    animation: au-plate-door-slap 0.42s var(--ease-slap)
      calc(0.1s + min(var(--order), 5) * 0.03s) backwards;
  }

  .au-plate-door__slab {
    position: absolute;
    inset: -18% -4% -22% -3%;
    z-index: -1;
    rotate: 2.5deg;
    background:
      radial-gradient(circle, rgba(6, 5, 13, 0.2) 0 1.3px, transparent 1.8px) 0 0 / 7px 7px,
      var(--door-colour);
    clip-path: polygon(3% 0, 100% 7%, 97% 100%, 0 90%);
    opacity: var(--pointed);
    scale: calc(0.9 + var(--pointed) * 0.1);
    translate: calc(var(--pointed) * 1.5%) calc(var(--pointed) * 6%);
    transition:
      opacity 0.28s var(--ease),
      scale 0.34s var(--ease),
      translate 0.34s var(--ease);
    pointer-events: none;
  }

  .au-plate-door__plate {
    display: inline-block;
    padding: 0.1em 0.2em 0.04em;
    rotate: var(--tilt);
    background: color-mix(in srgb, var(--door-paper) calc(var(--lit) * 100%), #08070d);
    color: color-mix(in srgb, var(--door-paper-ink) calc(var(--lit) * 100%), var(--ink));
    box-shadow: 0.06em 0.07em 0
      color-mix(
        in srgb,
        rgba(6, 5, 13, 0.72) calc(var(--lit) * 100%),
        color-mix(in srgb, var(--door-ink) 70%, transparent)
      );
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .au-plate-door__plate--small {
    align-self: flex-start;
    font-size: 0.42em;
    padding: 0.16em 0.3em 0.1em;
  }

  .au-plate-door__line {
    grid-area: line;
    font-family: var(--font-garamond);
    font-size: clamp(18px, 1.6vw, 26px);
    font-style: italic;
    line-height: 1.25;
    color: color-mix(in srgb, var(--ink) calc(var(--lit) * 100%), var(--ink2));
    text-shadow: 0 1px 2px rgba(6, 5, 13, 0.85);
    text-wrap: balance;
    transition: color 0.2s var(--ease);
  }

  @media (width < 640px) {
    .au-plate-door__link {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'mark'
        'name'
        'line';
    }
  }

  @media (width < 960px) {
    .au-plate-door__scene {
      display: none;
    }
  }

  @media (width >= 960px) {
    .au-plate-door__link {
      grid-template-areas:
        'mark name'
        'mark line';
      row-gap: 0;
      padding-block: calc(var(--name-px) * 0.16);
    }

    .au-plate-door__mark {
      align-self: center;
    }

    .au-plate-door__name {
      scale: calc(1 + var(--lit) * (var(--lit-scale) - 1));
      transform-origin: left bottom;
      translate: calc(var(--lit) * var(--lit-shift)) calc(var(--pointed) * -4px);
      transition:
        scale 0.24s cubic-bezier(0.2, 1.35, 0.4, 1),
        translate 0.24s var(--ease);
    }

    .au-plate-door__slab {
      inset: -8% -4% -16% -3%;
    }

    .au-plate-door__plate {
      color: color-mix(in srgb, var(--door-paper-ink) calc(var(--lit) * 100%), var(--ink2));
      box-shadow: 0.06em 0.07em 0
        color-mix(
          in srgb,
          rgba(6, 5, 13, 0.72) calc(var(--lit) * 100%),
          color-mix(in srgb, var(--door-ink) 45%, transparent)
        );
    }

    .au-plate-door__line {
      margin-top: calc(var(--name-px) * 0.12);
      font-size: clamp(16px, 1.25vw, 20px);
      opacity: calc(0.75 + var(--lit) * 0.25);
      transition: opacity 0.18s var(--ease);
    }
  }

  @media (forced-colors: active) {
    .au-plate-door__slab,
    .au-plate-door__scene {
      display: none;
    }

    .au-plate-door__plate {
      rotate: none;
      box-shadow: none;
    }

    .au-plate-door__link:focus-visible {
      outline-color: CanvasText;
    }
  }

  @media print {
    .au-plate-door__slab,
    .au-plate-door__scene {
      display: none;
    }

    .au-plate-door__name {
      translate: none;
    }

    .au-plate-door__plate {
      rotate: none;
      background: none;
      color: var(--door-paper-ink);
      box-shadow: none;
    }

    .au-plate-door__hex {
      filter: none;
    }

    .au-plate-door__hex polygon {
      fill: none;
      stroke: var(--door-paper-ink);
    }

    .au-plate-door__mark :global(.au-plate-door__glyph) {
      color: var(--door-paper-ink);
    }

    .au-plate-door__line {
      color: #3a3448;
      text-shadow: none;
    }
  }

  @keyframes au-plate-door-slap {
    from {
      transform: scale(1.35) rotate(-5deg);
    }
  }

  @keyframes au-plate-door-strike {
    from {
      transform: scale(1.3);
    }
  }
</style>
