---
type Props = { label: string; text: string }

const { label, text } = Astro.props
---

<span class="au-stat au-stat--prerequisite">
  <svg
    class="au-stat__icon"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M5 11V8a7 7 0 0 1 14 0v3" />
    <rect x="4" y="11" width="16" height="10" rx="2" />
  </svg>
  <span class="au-stat__label">{label}</span>
  {text}
</span>
