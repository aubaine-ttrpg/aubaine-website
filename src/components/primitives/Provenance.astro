---
import type { BrowseSource } from '../../lib/game/browse-entries'
import type { Corpus } from '../../lib/game/corpus'
import { KIND_MARKS, kindInk } from '../../lib/game/kind-marks'
import { flattenText, termLabels } from '../../lib/game/richtext'
import type { Locale } from '../../lib/i18n/locales'
import { strings } from '../../lib/i18n/strings'
import Icon from './Icon.astro'
import PopoverNote from './PopoverNote.astro'

type Props = {
  entryId: string
  label: string
  sources: BrowseSource[]
  corpus: Corpus
  locale: Locale
}

const { entryId, label, sources, corpus, locale } = Astro.props
const t = strings(locale)

const GOLD = 'var(--gold)'
const SOURCE_MARKS: Record<BrowseSource['kind'], { icon: string; colour: string }> = {
  tree: { icon: KIND_MARKS.trees.icon, colour: kindInk('trees') },
  species: { icon: KIND_MARKS.species.icon, colour: kindInk('species') },
  item: { icon: KIND_MARKS.equipment.icon, colour: kindInk('equipment') },
  skill: { icon: KIND_MARKS.skills.icon, colour: kindInk('skills') },
  basic: { icon: 'mdi:hexagon', colour: GOLD },
  bank: { icon: 'mdi:bank', colour: GOLD },
  other: { icon: 'mdi:information-outline', colour: GOLD },
}
const NOTE_WIDTH = 400
const labelOf = termLabels(corpus.terms)
const NOTES: Record<'basic' | 'bank' | 'other', string | undefined> = {
  basic: corpus.basic.note && flattenText(corpus.basic.note, labelOf),
  bank: corpus.bank.note && flattenText(corpus.bank.note, labelOf),
  other: t.otherNote,
}
---

{
  sources.length > 0 && (
    <div class="au-sources">
      <p class="au-sources__label" id={`src-${entryId}`}>
        {label}
      </p>
      <ul class="au-sources__list" aria-labelledby={`src-${entryId}`}>
        {sources.map((source) => (
          <li>
            {'href' in source ? (
              <a
                class="au-source"
                href={source.href}
                style={`--source-ink:${SOURCE_MARKS[source.kind].colour}`}
              >
                <Icon name={SOURCE_MARKS[source.kind].icon} class="au-source__icon" />
                <span>{source.title}</span>
              </a>
            ) : (
              <>
                <button
                  type="button"
                  class="au-source"
                  popovertarget={`note-${source.kind}-${entryId}`}
                  style={`anchor-name:--note-${source.kind}-${entryId}; --source-ink:${SOURCE_MARKS[source.kind].colour}`}
                >
                  <Icon name={SOURCE_MARKS[source.kind].icon} class="au-source__icon" />
                  <span>{source.title}</span>
                </button>
                <PopoverNote
                  id={`note-${source.kind}-${entryId}`}
                  title={source.title}
                  body={NOTES[source.kind]}
                  locale={locale}
                  width={NOTE_WIDTH}
                  kind={label}
                />
              </>
            )}
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .au-sources {
    margin-top: 22px;
    padding-top: 15px;
    border-top: 1px solid var(--accent-line);
  }
  .au-sources__label {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .au-sources__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .au-source {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 13px;
    border: 1px solid var(--line2);
    background: var(--field);
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }
  .au-source:hover,
  .au-source:focus-visible {
    border-color: var(--gold);
    background: var(--accent-soft);
  }
  .au-source :global(.au-source__icon) {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--source-ink);
  }
</style>
