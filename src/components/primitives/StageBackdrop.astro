---
import { STAGE } from '../../lib/art-effect/presets'
import { type StageSource, stageLook } from '../../lib/stage-ambient'

type Props = { source: StageSource }

const { source } = Astro.props

const { ambient, backdrop } = await stageLook(source)
const field = source.kind === 'field' ? source.colours.join('|') : undefined
const style = [
  `--stage-art:${backdrop}`,
  `--stage-bleed:${STAGE.bleed}px`,
  `--stage-blur:${STAGE.blur}px`,
  `--stage-saturate:${STAGE.saturate}`,
  `--stage-brightness:${STAGE.brightness}`,
].join('; ')
---

<div class="au-stage" data-stage={ambient} data-stage-field={field} style={style} aria-hidden="true">
  <span class="au-stage__ambient"></span>
  <span class="au-stage__shade"></span>
  <span class="au-stage__halftone"></span>
</div>

<style>
  .au-stage {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: clip;
    pointer-events: none;
  }

  .au-stage > :global(canvas),
  .au-stage__ambient,
  .au-stage__shade,
  .au-stage__halftone {
    position: absolute;
    inset: 0;
    display: block;
  }

  .au-stage > :global(canvas) {
    width: 100%;
    height: 100%;
  }

  .au-stage[data-staged] > .au-stage__ambient {
    visibility: hidden;
  }

  .au-stage__ambient {
    inset: calc(var(--stage-bleed) * -1);
    background-image: var(--stage-art);
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    filter: blur(var(--stage-blur)) saturate(var(--stage-saturate))
      brightness(var(--stage-brightness));
  }

  .au-stage__shade {
    background:
      radial-gradient(120% 90% at 70% 40%, transparent 30%, rgba(6, 5, 13, 0.7) 100%),
      linear-gradient(180deg, rgba(6, 5, 13, 0.1) 0%, rgba(6, 5, 13, 0.55) 52%, var(--bg) 100%);
  }

  .au-stage__halftone {
    background-image: radial-gradient(circle, rgba(6, 5, 13, 0.6) 0 1.5px, transparent 2px);
    background-size: 8px 8px;
    mask-image: linear-gradient(30deg, #000 0%, rgba(0, 0, 0, 0.5) 28%, transparent 58%);
  }

  @media (min-width: 960px) {
    .au-stage__shade {
      background:
        radial-gradient(90% 110% at 78% 45%, transparent 25%, rgba(6, 5, 13, 0.62) 100%),
        linear-gradient(
          90deg,
          rgba(6, 5, 13, 0.84) 0%,
          rgba(6, 5, 13, 0.5) 42%,
          rgba(6, 5, 13, 0.08) 100%
        );
    }
  }

  @media (forced-colors: active) {
    .au-stage__halftone {
      display: none;
    }
  }

  @media print {
    .au-stage {
      display: none;
    }
  }
</style>
