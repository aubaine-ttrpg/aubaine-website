---
import type { Locale } from '../../lib/i18n/locales'
import { strings } from '../../lib/i18n/strings'
import Icon from './Icon.astro'

type Props = { locale: Locale; class?: string }

const { locale, class: className, ...rest } = Astro.props
const t = strings(locale)
---

<button
  type="button"
  class:list={['au-still', className]}
  data-stage-toggle
  data-pause={t.stagePause}
  data-play={t.stagePlay}
  aria-label={t.stagePause}
  hidden
  {...rest}
>
  <Icon name="mdi:pause" class="au-still__icon au-still__icon--pause" />
  <Icon name="mdi:play" class="au-still__icon au-still__icon--play" />
</button>

<style>
  .au-still {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid var(--line2);
    background: rgba(6, 5, 13, 0.6);
    color: var(--ink2);
    cursor: pointer;
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .au-still[hidden] {
    display: none;
  }

  .au-still:hover,
  .au-still:focus-visible {
    color: var(--gold);
    border-color: var(--gold);
  }

  .au-still :global(.au-still__icon) {
    width: 18px;
    height: 18px;
  }

  .au-still :global(.au-still__icon--play),
  :global([data-still]) .au-still :global(.au-still__icon--pause) {
    display: none;
  }

  :global([data-still]) .au-still :global(.au-still__icon--play) {
    display: block;
  }

  @media (min-width: 960px) {
    .au-still {
      right: 26px;
      bottom: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .au-still {
      display: none;
    }
  }

  @media print {
    .au-still {
      display: none;
    }
  }
</style>
