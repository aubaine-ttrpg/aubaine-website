---
import { inkOn } from '../../lib/key-colour'
import CharacteristicHex from './CharacteristicHex.astro'

export type Trait = {
  iconName: string | undefined
  color: string
  label: string
  text: string
}

type Props = { traits: Trait[]; groupLabel: string }

const { traits, groupLabel } = Astro.props

const TILTS = ['-1.5deg', '1deg', '-2deg', '1.5deg'] as const
---

<div class="au-traits" role="group" aria-label={groupLabel}>
  <dl class="au-traits__list">
    {
      traits.map((trait, order) => (
        <div
          class="au-trait"
          style={`--paper:${trait.color}; --ink:${inkOn(trait.color)}; --tilt:${TILTS[order % TILTS.length]}; --order:${order}`}
        >
          <dt class="au-trait__label">{trait.label}</dt>
          <dd class="au-trait__value">
            <CharacteristicHex
              iconName={trait.iconName}
              color={inkOn(trait.color)}
              label={trait.label}
              glyphColor={trait.color}
              width="27px"
              height="30px"
              iconSize="15px"
              filter="none"
            />
            <span class="au-trait__text">{trait.text}</span>
          </dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .au-traits__list {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 16px;
    margin: 0;
  }

  .au-trait {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    rotate: var(--tilt);
    animation: au-trait-slap 0.42s cubic-bezier(0.2, 1.45, 0.4, 1)
      calc(0.34s + var(--order) * 0.07s) backwards;
  }

  .au-trait__label {
    align-self: flex-start;
    position: relative;
    z-index: 1;
    margin: 0 0 -7px 10px;
    padding: 4px 8px 3px;
    rotate: -2.5deg;
    background: #08070d;
    color: color-mix(in srgb, var(--paper) 45%, #fff);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    line-height: 1.2;
    text-transform: uppercase;
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.5);
  }

  .au-trait__value {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 12px 16px 9px 12px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 4px 5px 0 rgba(0, 0, 0, 0.62);
  }

  .au-trait__text {
    font-family: var(--font-ui);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  @keyframes au-trait-slap {
    from {
      transform: scale(1.35) rotate(-5deg);
    }
  }
</style>
