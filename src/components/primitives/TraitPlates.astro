---
import type { Trait } from '../../lib/game/character-sheet'
import { DARK_INK, readableOnNight } from '../../lib/key-colour'
import CharacteristicHex from './CharacteristicHex.astro'

type Props = { traits: readonly Trait[]; groupLabel: string; size?: 'sheet' | 'preview' }

const { traits, groupLabel, size = 'sheet' } = Astro.props

const TILTS = ['-1.5deg', '1deg', '-2deg', '1.5deg'] as const
---

<div class:list={['au-traits', `au-traits--${size}`]} role="group" aria-label={groupLabel}>
  <dl class="au-traits__list">
    {
      traits.map((trait, order) => (
        <div
          class="au-trait"
          style={`--paper:${readableOnNight(trait.color)}; --ink:${DARK_INK}; --tilt:${TILTS[order % TILTS.length]}; --order:${order}`}
        >
          <dt class="au-trait__label">{trait.label}</dt>
          <dd class="au-trait__value">
            <CharacteristicHex
              iconName={trait.iconName}
              color={DARK_INK}
              label={trait.label}
              glyphColor={readableOnNight(trait.color)}
              width="var(--trait-hex-width, 27px)"
              height="var(--trait-hex-height, 30px)"
              iconSize="var(--trait-icon, 15px)"
              filter="none"
            />
            <span class="au-trait__text">{trait.text}</span>
          </dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .au-traits__list {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 16px;
    margin: 0;
  }

  .au-trait {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    rotate: var(--tilt);
    animation: au-trait-slap calc(0.42s * var(--arrival, 1)) cubic-bezier(0.2, 1.45, 0.4, 1)
      calc((0.34s + var(--order) * 0.07s) * var(--arrival, 1)) backwards;
  }

  .au-trait__label {
    align-self: flex-start;
    position: relative;
    z-index: 1;
    margin: 0 0 -7px 10px;
    padding: 4px 8px 3px;
    rotate: -2.5deg;
    background: #08070d;
    color: color-mix(in srgb, var(--paper) 45%, #fff);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.2em;
    line-height: 1.2;
    text-transform: uppercase;
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.5);
  }

  .au-trait__value {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 12px 16px 9px 12px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 4px 5px 0 rgba(0, 0, 0, 0.62);
  }

  .au-trait__text {
    font-family: var(--font-ui);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  .au-traits--preview {
    --trait-hex-width: 20px;
    --trait-hex-height: 22px;
    --trait-icon: 11px;
  }

  .au-traits--preview .au-traits__list {
    gap: 14px 8px;
  }

  .au-traits--preview .au-trait {
    flex: 0 1 auto;
    min-width: 0;
  }

  .au-traits--preview .au-trait__label {
    margin: 0 0 -6px 8px;
    padding: 3px 6px 2px;
    font-size: 8.5px;
    white-space: nowrap;
  }

  .au-traits--preview .au-trait__value {
    gap: 6px;
    padding: 8px 10px 6px 8px;
    box-shadow: 3px 4px 0 rgba(0, 0, 0, 0.62);
  }

  .au-traits--preview .au-trait__text {
    font-size: clamp(12px, 3cqi, 14px);
    letter-spacing: 0.04em;
    line-height: 1.1;
  }

  @keyframes au-trait-slap {
    from {
      transform: scale(1.35) rotate(-5deg);
    }
  }
</style>
