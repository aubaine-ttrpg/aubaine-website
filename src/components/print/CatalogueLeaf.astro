---
import Divider from '../primitives/Divider.astro'
import Leaf from './Leaf.astro'

type Props = {
  heading: string
  sub: string
  title: string
}

const { heading, sub, title } = Astro.props
---

<Leaf flow numbered>
  <div class="au-sheet">
    <div class="au-plate">
      <header class="au-catalogue__head">
        <span class="au-catalogue__title" data-running-head>{heading}</span>
        <span class="au-catalogue__sub">{sub}</span>
      </header>

      <div class="au-catalogue__columns" data-columns>
        <slot />
      </div>

      <footer class="au-catalogue__foot">
        <Divider />
        <span class="au-catalogue__foot-meta">
          <span>{`Aubaine · ${title}`}</span>
          <span data-page-number></span>
        </span>
      </footer>
    </div>
  </div>
</Leaf>
