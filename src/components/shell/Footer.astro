---
import { policyPages } from '../../lib/game/policies'
import { AUBAINE_VERSION } from '../../lib/game/version'
import type { Locale } from '../../lib/i18n/locales'
import { pathFor } from '../../lib/i18n/routes'
import { strings } from '../../lib/i18n/strings'
import { HOLDER, LICENCE, YEAR } from '../../lib/rights/claim'
import Logo from './Logo.astro'

type Props = { locale: Locale }

const { locale } = Astro.props
const t = strings(locale)

const exploreLinks = [
  { title: t.almanach, href: pathFor('almanach', locale), archives: undefined },
  { title: t.resources, href: pathFor('books', locale), archives: undefined },
  { title: t.versionHistory, href: pathFor('archives', locale), archives: true },
]

const projectLinks = (await policyPages(locale)).map((policy) => ({
  title: policy.title,
  href: pathFor(policy.kind, locale),
}))

const columnHeadStyle =
  'margin:0 0 12px; font-family:var(--font-mono); font-size:10.5px; letter-spacing:.22em; text-transform:uppercase; color:var(--gold)'
const listStyle = 'list-style:none; margin:0; padding:0; display:grid; gap:9px'
const microStyle =
  'font-family:var(--font-mono); font-size:10.5px; letter-spacing:.1em; color:var(--ink3)'
---

<footer id="site-footer" style="border-top:1px solid var(--line); background:var(--bg2)">
  <div style="max-width:1560px; margin:0 auto; padding:44px 26px 40px">
    <div style="display:flex; flex-wrap:wrap; gap:36px 64px; align-items:flex-start">
      <div style="flex:1 1 220px; min-width:0">
        <a
          href={pathFor('home', locale)}
          translate="no"
          aria-label="Aubaine"
          style="display:inline-flex; align-items:center; gap:11px"
        >
          <Logo size={28} color="var(--gold)" />
          <span
            style="font-family:var(--font-display); font-weight:700; font-size:17px; letter-spacing:.22em; color:var(--ink)"
            >AUBAINE</span
          >
        </a>
        <p translate="no" style={`margin:12px 0 0; ${microStyle}`}>v{AUBAINE_VERSION}</p>
      </div>

      <nav aria-labelledby="footer-explore" style="flex:0 1 auto; min-width:0">
        <h2 id="footer-explore" style={columnHeadStyle}>{t.footerExplore}</h2>
        <ul style={listStyle}>
          {
            exploreLinks.map((link) => (
              <li>
                <a href={link.href} data-footer-link data-footer-archives={link.archives}>
                  {link.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-project" style="flex:0 1 auto; min-width:0">
        <h2 id="footer-project" style={columnHeadStyle}>{t.policies}</h2>
        <ul style={listStyle}>
          {
            projectLinks.map((link) => (
              <li>
                <a href={link.href} data-footer-link>
                  {link.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      style="margin-top:40px; padding-top:20px; border-top:1px solid var(--line); display:flex; flex-wrap:wrap; gap:10px 24px; justify-content:space-between; align-items:center"
    >
      <span translate="no" style={microStyle}>
        &#169; {YEAR} {HOLDER} &#183; <a href={pathFor('licences', locale)} data-footer-licence
          >{LICENCE.id}</a
        >
      </span>
      <span style={microStyle}>{t.footerNote(AUBAINE_VERSION)}</span>
    </div>
  </div>
</footer>

<style>
  [data-footer-link] {
    font-family: var(--font-ui);
    font-size: 14.5px;
    color: var(--ink2);
    transition: color 0.2s var(--ease);
  }

  [data-footer-licence] {
    color: var(--ink2);
    transition: color 0.2s var(--ease);
  }

  [data-footer-link]:hover,
  [data-footer-licence]:hover {
    color: var(--gold);
  }
</style>
