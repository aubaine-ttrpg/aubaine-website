---
type Props = { size?: number; color?: string }

const { size = 26, color = '#efbe04' } = Astro.props
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  stroke={color}
  stroke-width="2.6"
  style="flex:none; display:block"
>
  <polygon points="50,6 88,28 88,72 50,94 12,72 12,28"></polygon>
  <polygon points="50,17 78.5,33.5 78.5,66.5 50,83 21.5,66.5 21.5,33.5"></polygon>
</svg>
