---
import Logo from './Logo.astro'

type Props = { home: string }

const { home } = Astro.props
---

<header
  id="site-header"
  data-shell-header
  style="position:sticky; top:0; z-index:50; border-bottom:1px solid rgba(255,255,255,.12); box-shadow:inset 0 1px 0 rgba(255,255,255,.08); background:rgba(6,5,13,.94)"
>
  <div
    style="margin:0 auto; padding:9px 26px; display:flex; flex-wrap:wrap; align-items:center; gap:9px 14px; min-height:64px"
  >
    <a
      href={home}
      translate="no"
      style="display:flex; align-items:center; gap:11px; flex:none"
      aria-label="Aubaine"
    >
      <Logo size={26} />
      <span
        style="font-family:var(--font-display); font-weight:700; font-size:17px; letter-spacing:.22em; color:#f6f2e6"
        >AUBAINE</span
      >
    </a>
    <slot />
  </div>
</header>
