---
import { formatReleaseDate } from '../../lib/booklet/format'
import { currentVersion, noteFor, releasesFor } from '../../lib/booklet/manifest'
import type { Corpus } from '../../lib/game/build'
import { formatNumber } from '../../lib/game/derive'
import { ARCHIVES_ART, bookletHead } from '../../lib/game/pages'
import type { Locale } from '../../lib/i18n/locales'
import { strings } from '../../lib/i18n/strings'
import { releaseHref } from '../../lib/media'
import Hero from '../primitives/Hero.astro'
import ReleaseRow from '../primitives/ReleaseRow.astro'

type Props = { locale: Locale; corpus: Corpus; slug: string }

const { locale, corpus, slug } = Astro.props
const t = strings(locale)

const history = releasesFor(slug, locale)
const [newest] = history
if (!newest) throw new Error(`no booklet release for ${slug} in ${locale}`)

const head = bookletHead(corpus, newest.kind, slug)
const current = currentVersion()
---

<div>
  <Hero
    art={head.banner ?? ARCHIVES_ART}
    objectPosition="50% 30%"
    motion="drift"
    seconds={22}
    priority
    minHeight="min(52vh,440px)"
    bottomStops={[28, 60]}
    sideStops={[32, 64]}
    padding="0 26px 40px"
  >
    <h1
      style="margin:0; font-family:var(--font-display); font-weight:700; font-size:clamp(34px,5vw,72px); line-height:.98; color:var(--art-ink)"
    >
      {head.title}
    </h1>
    <p
      style="margin:16px 0 0; max-width:58ch; font-size:19px; line-height:1.6; color:var(--art-ink2)"
    >
      {t.archiveLead}
    </p>
  </Hero>

  <section style="max-width:1560px; margin:0 auto; padding:40px 26px 80px">
    <ul style="list-style:none; margin:0; padding:0">
      {
        history.map((release) => (
          <ReleaseRow
            locale={locale}
            title={`v${release.version}`}
            sub={`${formatReleaseDate(noteFor(release.version)?.date ?? release.generatedAt, locale)} · ${formatNumber(release.pages, locale)} ${t.releasePages}`}
            bytes={release.bytes}
            href={releaseHref(release)}
            current={release.version === current}
            archived={release.archive !== undefined}
          />
        ))
      }
    </ul>
  </section>
</div>
