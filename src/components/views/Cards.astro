---
import type { Corpus } from '../../lib/game/corpus'
import { bookDot, bookLink, indexDescriptors } from '../../lib/game/indexes'
import type { Locale } from '../../lib/i18n/locales'
import { pathFor } from '../../lib/i18n/routes'
import { strings } from '../../lib/i18n/strings'
import { PLACEHOLDER_BANNER } from '../../lib/media'
import Card from '../primitives/Card.astro'
import Hero from '../primitives/Hero.astro'
import { enterDelay, STAGGER_STEP } from '../primitives/stagger'

type Variant = 'books' | 'almanach'

type Props = { locale: Locale; corpus: Corpus; variant: Variant }

type CardModel = {
  title: string
  kicker: string
  mark: string
  href?: string | undefined
  download?: boolean | undefined
  art?: string | undefined
  desc?: string | undefined
  cta?: string | undefined
  delay: number
}

const { locale, corpus, variant } = Astro.props
const t = strings(locale)

const HERO_ART: Record<Variant, string> = {
  books: 'bibliotheque-des-oracles-16_9-og.png',
  almanach: 'bureau-de-archibald-16_9-upscaled_4.jpg',
}

const HERO_TEXT: Record<Variant, { title: string; lead: string }> = {
  books: { title: t.resources, lead: t.hubLead },
  almanach: { title: t.almanach, lead: t.almanachLead },
}

const bookCards = (): CardModel[] =>
  corpus.books
    .flatMap((book) => {
      const link = bookLink(book, locale)
      return link ? [{ book, link }] : []
    })
    .map(({ book, link }, index) => ({
      title: book.title,
      kicker: t.resEyebrowShort,
      mark: bookDot(book.order),
      art: book.cover ?? book.banner ?? PLACEHOLDER_BANNER,
      desc: book.description,
      cta: link.download ? t.download : t.read,
      href: link.href,
      download: link.download ? true : undefined,
      delay: enterDelay(index, STAGGER_STEP.card),
    }))

const indexCards = (): CardModel[] =>
  indexDescriptors(locale).map((entry, index) => ({
    title: entry.title,
    kicker: t.almanach,
    mark: entry.mark,
    art: entry.art,
    desc: entry.description,
    cta: t.browse_,
    href: pathFor(entry.kind, locale),
    delay: enterDelay(index, STAGGER_STEP.card),
  }))

const cards: CardModel[] = variant === 'books' ? bookCards() : indexCards()

const hero = HERO_TEXT[variant]
---

<div>
  <Hero
    art={HERO_ART[variant]}
    objectPosition="50% 26%"
    motion="drift"
    seconds={22}
    priority
    minHeight="min(60vh,520px)"
    bottomStops={[28, 60]}
    sideStops={[32, 64]}
    padding="0 26px 44px"
  >
    <h1
      style="margin:0; font-family:var(--font-display); font-weight:700; font-size:clamp(42px,6.4vw,96px); line-height:.95; color:var(--art-ink)"
    >
      {hero.title}
    </h1>
    <p
      style="margin:16px 0 0; max-width:58ch; font-size:19px; line-height:1.6; color:var(--art-ink2)"
    >
      {hero.lead}
    </p>
  </Hero>
  <section style="max-width:1560px; margin:0 auto; padding:40px 26px 80px">
    {
      cards.length > 0 && (
        <ul style="list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(auto-fill,minmax(min(100%,318px),1fr)); gap:22px">
          {cards.map((item) => (
            <Card
              locale={locale}
              title={item.title}
              kicker={item.kicker}
              mark={item.mark}
              href={item.href}
              download={item.download}
              art={item.art}
              desc={item.desc}
              cta={item.cta}
              delay={item.delay}
            />
          ))}
        </ul>
      )
    }
  </section>
</div>
