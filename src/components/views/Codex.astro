---
import type { Corpus } from '../../lib/game/corpus'
import { codexDoors } from '../../lib/game/hub-doors'
import type { Locale } from '../../lib/i18n/locales'
import { strings } from '../../lib/i18n/strings'
import PlateMenu from '../primitives/PlateMenu.astro'

type Props = { locale: Locale; corpus: Corpus }

const { locale, corpus } = Astro.props
const t = strings(locale)
---

<PlateMenu
  locale={locale}
  title={t.almanach}
  about={{ body: t.almanachLead }}
  doors={await codexDoors(corpus, locale)}
/>
