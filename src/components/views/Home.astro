---
import type { Corpus } from '../../lib/game/corpus'
import type { Locale } from '../../lib/i18n/locales'
import { pathFor } from '../../lib/i18n/routes'
import { strings } from '../../lib/i18n/strings'
import Banner from '../primitives/Banner.astro'

type Props = { locale: Locale; corpus: Corpus }

const { locale, corpus } = Astro.props
const t = strings(locale)
---

<div style="flex:1; min-height:0; display:flex; flex-direction:column">
  <section
    style="position:relative; flex:1; min-height:calc(100dvh - var(--header-h)); display:flex; align-items:flex-end; overflow:hidden"
  >
    <Banner art="le-bastion-16_9-upscaled_2.jpg" objectPosition="52% 42%" motion="burns" priority />
    <video
      data-hero-video="/video/le-bastion-16_9-compressed.mp4"
      muted
      playsinline
      preload="auto"
      aria-hidden="true"
      tabindex="-1"
      style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:52% 42%; opacity:0; transition:opacity 1.6s linear; pointer-events:none; animation:au-burns 1s cubic-bezier(.4,.02,.28,1) both; will-change:transform; backface-visibility:hidden"
    ></video>
    <span
      aria-hidden="true"
      style="position:absolute; inset:0; background:linear-gradient(0deg, rgba(6,5,13,.95) 0%, rgba(6,5,13,.78) 22%, rgba(6,5,13,.5) 46%, rgba(6,5,13,.2) 70%, rgba(6,5,13,0) 92%)"
    ></span>
    <span
      aria-hidden="true"
      style="position:absolute; inset:0; background:linear-gradient(90deg, rgba(6,5,13,.72) 0%, rgba(6,5,13,.44) 34%, rgba(6,5,13,.12) 62%, rgba(6,5,13,0) 82%)"
    ></span>
    <div
      style="position:relative; width:100%; max-width:1560px; margin:0 auto; padding:clamp(20px,5dvh,64px) 26px clamp(22px,6dvh,80px); display:flex; flex-direction:column; gap:clamp(10px,2.2dvh,26px)"
    >
      <h1
        style="margin:0; max-width:17ch; font-family:var(--font-display); font-weight:700; font-size:clamp(34px,min(8.4vw,10dvh),140px); line-height:.94; color:var(--art-ink); text-wrap:balance; animation:au-rise .7s var(--ease) .06s both"
      >
        {t.heroTitle}
      </h1>
      <p
        style="margin:0; max-width:56ch; font-size:clamp(15px,min(1.4vw,2.6dvh),21px); line-height:1.58; color:var(--art-ink2); text-wrap:pretty; animation:au-rise .7s var(--ease) .14s both"
      >
        {t.heroLead(corpus.trees.length, corpus.species.length)}
      </p>
      <div
        style="display:flex; flex-wrap:wrap; gap:11px; padding-top:clamp(2px,1dvh,12px); animation:au-rise .7s var(--ease) .22s both"
      >
        <a
          href={pathFor('trees', locale)}
          data-cta-gold
          style="padding:12px 22px; font-family:var(--font-ui); font-size:16px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--on-gold); background:var(--gold); transition:transform .2s var(--ease), filter .2s var(--ease)"
          >{t.ctaTrees}</a
        >
        <a
          href={pathFor('books', locale)}
          data-cta-ghost
          style="padding:12px 22px; font-family:var(--font-ui); font-size:16px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:#f4eedf; border:1px solid rgba(255,255,255,.22); box-shadow:inset 0 1px 0 rgba(255,255,255,.14); background:rgba(6,6,16,.62); transition:border-color .2s var(--ease), transform .2s var(--ease)"
          >{t.ctaRes}</a
        >
      </div>
    </div>
  </section>
</div>

<style is:global>
  [data-cta-gold]:hover {
    filter: brightness(1.08);
  }
  [data-cta-gold]:active,
  [data-cta-ghost]:active {
    transform: translateY(1px);
  }
  [data-cta-ghost]:hover {
    border-color: var(--gold);
  }
</style>
