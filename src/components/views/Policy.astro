---
import { policyPages } from '../../lib/game/policies'
import { renderProse } from '../../lib/game/prose'
import type { Locale } from '../../lib/i18n/locales'
import type { PolicyKind } from '../../lib/i18n/routes'
import { strings } from '../../lib/i18n/strings'
import { creditSections } from '../../lib/rights/credits'
import { titleFrameStyle } from '../../lib/title-frames'
import Attribution from '../primitives/Attribution.astro'
import PageTitle from '../primitives/PageTitle.astro'
import SectionTrail from '../primitives/SectionTrail.astro'
import '../../styles/almanach.css'
import '../../styles/prose.css'
import '../../styles/reading.css'
import '../../styles/titles.css'

type Props = { locale: Locale; kind: PolicyKind }

const { locale, kind } = Astro.props
const t = strings(locale)

const page = (await policyPages(locale)).find((entry) => entry.kind === kind)
if (!page) throw new Error(`Unknown policy kind: ${kind}`)

const { Content, headings } = await renderProse(page.entry)
const frameStyle = await titleFrameStyle()

const outline = [
  ...headings.filter((heading) => heading.depth === 2).map(({ slug, text }) => ({ slug, text })),
  ...(kind === 'credits'
    ? creditSections(t).map((section) => ({ slug: section.id, text: section.heading }))
    : []),
].map((section, position) => ({
  text: section.text,
  href: `#${section.slug}`,
  num: String(position + 1).padStart(2, '0'),
}))
---

<div class="au-reading">
  <header class="au-reading__head au-policy__head au-titles" style={frameStyle}>
    <PageTitle text={page.title} line={page.description} />
  </header>

  {
    outline.length > 1 && (
      <nav class="au-aside" aria-label={t.onThisPage}>
        <p class="au-eyebrow">{t.onThisPage}</p>
        <SectionTrail sections={outline} />
      </nav>
    )
  }

  <article class="au-reading__body au-titles" style={frameStyle}>
    <div class="au-prose">
      <Content />
    </div>
    {kind === 'credits' && <Attribution locale={locale} />}
  </article>
</div>

<style>
  .au-reading__head.au-policy__head {
    padding-block-end: 0;
    border-block-end: 0;
  }
</style>
