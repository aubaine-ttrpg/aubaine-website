---
import { skillBrowseEntries } from '../../lib/game/browse-entries'
import type { Corpus, ResolvedSpecies } from '../../lib/game/corpus'
import { label } from '../../lib/game/corpus'
import {
  DEFAULT_MOVEMENT_METRES,
  formatNumber,
  SPECIES_PLATE_ICONS,
  subspeciesAnchor,
} from '../../lib/game/derive'
import { loreFor } from '../../lib/game/prose'
import { badgedStatus } from '../../lib/game/status'
import type { Locale } from '../../lib/i18n/locales'
import { strings } from '../../lib/i18n/strings'
import { PLACEHOLDER_BANNER } from '../../lib/media'
import BrowseList from '../primitives/BrowseList.astro'
import Hero from '../primitives/Hero.astro'
import RuleText from '../primitives/RuleText.astro'
import SectionHead from '../primitives/SectionHead.astro'
import SectionTrail from '../primitives/SectionTrail.astro'
import StatusBadge from '../primitives/StatusBadge.astro'
import TraitPlates from '../primitives/TraitPlates.astro'
import '../../styles/prose.css'
import '../../styles/reading.css'

type Props = { locale: Locale; corpus: Corpus; species: ResolvedSpecies }

const PLATE_COLOUR = '#fbf8ef'
const PLATE_GLYPH = '#08070d'

const { locale, corpus, species } = Astro.props
const t = strings(locale)

const status = badgedStatus(species.status)
const named = (map: Corpus['creatureTypes'], keys: string[]): string[] =>
  keys.map((key) => label(map.get(key), locale, key))

const creatureTypes = named(corpus.creatureTypes, species.types ?? [])
const sizes = named(corpus.sizes, species.size ?? [])
const derived =
  species.derivedFrom === 'origin'
    ? t.sizeFromOrigin
    : species.derivedFrom === 'parents'
      ? t.sizeFromOrigins
      : undefined

const plates = [
  ...(creatureTypes.length > 0
    ? [{ icon: SPECIES_PLATE_ICONS.type, label: t.creatureType, value: creatureTypes.join(' · ') }]
    : []),
  ...(derived
    ? [{ icon: SPECIES_PLATE_ICONS.derived, label: t.speciesOrigin, value: derived }]
    : [
        {
          icon: SPECIES_PLATE_ICONS.movement,
          label: t.movement,
          value: species.movement ?? `${formatNumber(DEFAULT_MOVEMENT_METRES, locale)} m`,
        },
        ...(sizes.length > 0
          ? [
              {
                icon: SPECIES_PLATE_ICONS.size,
                label: t.sizeCategory,
                value: sizes.join(` ${t.or} `),
              },
            ]
          : []),
      ]),
]

const SUBSPECIES_ID = 'origines-regionales'
const PLAYING_ID = 'jouer'

const languages = named(corpus.languages, species.languages ?? [])
const roleplay = species.roleplay
const playing = [
  ...(roleplay?.adulthood ? [{ label: t.adulthood, value: roleplay.adulthood }] : []),
  ...(roleplay?.lifespan ? [{ label: t.lifespan, value: roleplay.lifespan }] : []),
  ...(roleplay?.height ? [{ label: t.height, value: roleplay.height }] : []),
  ...(languages.length > 0 ? [{ label: t.languages, value: languages.join(', ') }] : []),
]
const hasSubspecies = species.subspecies.length > 0
const hasPlaying = roleplay?.text !== undefined || playing.length > 0 || hasSubspecies

const lore = await loreFor('species', species.id, locale)
const LoreContent = lore?.Content
const hasReading = LoreContent !== undefined || hasSubspecies || hasPlaying
const trail = [
  ...(lore?.headings ?? [])
    .filter((heading) => heading.depth === 2)
    .map((heading) => ({ text: heading.text, href: `#${heading.slug}` })),
  ...(hasSubspecies
    ? [
        {
          text: t.subspecies,
          href: `#${SUBSPECIES_ID}`,
          sections: species.subspecies.map((sub) => ({
            text: sub.name,
            href: `#${subspeciesAnchor(sub.id)}`,
          })),
        },
      ]
    : []),
  ...(hasPlaying ? [{ text: t.playingAs(species.name), href: `#${PLAYING_ID}` }] : []),
  { text: t.speciesOffer, href: '#skills' },
].map((section, position) => ({ ...section, num: String(position + 1).padStart(2, '0') }))

const entries = skillBrowseEntries(species.pool, corpus, locale, species)
---

<div>
  <Hero
    art={species.banner ?? PLACEHOLDER_BANNER}
    objectPosition="52% 28%"
    motion="zoom-drift"
    seconds={24}
    settle={1}
    large
    priority
    minHeight="min(92vh,900px)"
    bottomStops={[26, 58]}
    sideStops={[30, 62]}
    padding="0 26px 48px"
    scrollCue={t.scrollCueSpecies}
  >
    <div slot="overlay" style="position:absolute; top:26px; left:0; right:0; z-index:3; pointer-events:none">
      <div style="max-width:1560px; margin:0 auto; padding:0 26px; display:flex; justify-content:flex-end">
        <TraitPlates
          traits={plates.map((plate) => ({
            iconName: plate.icon,
            color: PLATE_COLOUR,
            label: plate.label,
            text: plate.value,
          }))}
          groupLabel={t.speciesVitals}
          glyphColor={PLATE_GLYPH}
        />
      </div>
    </div>

    <div style="min-width:0">
      {
        status && (
          <div style="padding:0 0 16px">
            <StatusBadge status={status} locale={locale} />
          </div>
        )
      }
      <h1
        style="margin:0; font-family:var(--font-display); font-weight:700; font-size:clamp(46px,7.4vw,118px); line-height:.93; color:var(--art-ink); animation:au-rise .6s var(--ease) both"
      >
        {species.name}
      </h1>
      {
        species.subtitle && (
          <p style="margin:14px 0 0; font-family:var(--font-garamond); font-style:italic; font-size:clamp(19px,2.2vw,30px); line-height:1.3; color:var(--art-ink2); animation:au-rise .6s var(--ease) .06s both">
            {species.subtitle}
          </p>
        )
      }
    </div>
  </Hero>

  {
    hasReading && (
      <div class="au-reading">
        {trail.length > 1 && (
          <nav class="au-aside" aria-label={t.onThisPage}>
            <p class="au-eyebrow">{t.onThisPage}</p>
            <SectionTrail sections={trail} />
          </nav>
        )}
        <div class="au-reading__body">
          <div class="au-prose">
            {LoreContent && <LoreContent />}

            {hasSubspecies && (
              <section>
                <h2 id={SUBSPECIES_ID}>{t.subspecies}</h2>
                {species.subspecies.map((sub) => (
                  <article id={subspeciesAnchor(sub.id)} class="au-subspecies">
                    <h3>{sub.name}</h3>
                    <RuleText source={sub.text} corpus={corpus} locale={locale} />
                    {sub.names && (
                      <dl>
                        <dt>{t.namesMasculine}</dt>
                        <dd>{sub.names.masculine.join(', ')}</dd>
                        <dt>{t.namesFeminine}</dt>
                        <dd>{sub.names.feminine.join(', ')}</dd>
                        <dt>{t.namesFamily}</dt>
                        <dd>{sub.names.family.join(', ')}</dd>
                      </dl>
                    )}
                  </article>
                ))}
              </section>
            )}

            {hasPlaying && (
              <section>
                <h2 id={PLAYING_ID}>{t.playingAs(species.name)}</h2>
                {roleplay?.text && <RuleText source={roleplay.text} corpus={corpus} locale={locale} />}
                {(playing.length > 0 || hasSubspecies) && (
                  <dl>
                    {playing.map((row) => (
                      <>
                        <dt>{row.label}</dt>
                        <dd>{row.value}</dd>
                      </>
                    ))}
                    {hasSubspecies && (
                      <>
                        <dt>{t.subspecies}</dt>
                        <dd>
                          {species.subspecies.map((sub, index) => (
                            <>
                              {index > 0 && ', '}
                              <a href={`#${subspeciesAnchor(sub.id)}`}>{sub.name}</a>
                            </>
                          ))}
                        </dd>
                      </>
                    )}
                  </dl>
                )}
              </section>
            )}
          </div>
        </div>
      </div>
    )
  }

  <section>
    <div style="max-width:1560px; margin:0 auto; padding:40px 26px 0">
      <SectionHead
        title={t.speciesOffer}
        count={`${formatNumber(species.pool.length, locale)} ${t.entries_}`}
        id="skills"
      />
      {
        species.pool.length === 0 && (
          <p style="margin:0; padding-bottom:80px; max-width:var(--measure); font-size:var(--prose-body); line-height:1.7; color:var(--ink2)">
            {t.speciesEmpty}
          </p>
        )
      }
    </div>
    {
      species.pool.length > 0 && (
        <BrowseList
          locale={locale}
          corpus={corpus}
          entries={entries}
          label={t.speciesOffer}
          variant="speciesSkills"
        />
      )
    }
  </section>
</div>

<style>
  .au-reading {
    padding-block: 40px 0;
  }

  .au-subspecies {
    scroll-margin-top: var(--sticky-top);
  }
</style>
