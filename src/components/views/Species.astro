---
import { skillBrowseEntries } from '../../lib/game/browse-entries'
import { speciesSheet } from '../../lib/game/character-sheet'
import type { Corpus, ResolvedSpecies } from '../../lib/game/corpus'
import { label } from '../../lib/game/corpus'
import {
  formatNumber,
  HERALDRY_PLACEMENT,
  SUBSPECIES_SECTIONS,
  subspeciesAnchor,
} from '../../lib/game/derive'
import { loreFor } from '../../lib/game/prose'
import type { SubspeciesLabel } from '../../lib/game/schema'
import type { Locale } from '../../lib/i18n/locales'
import { strings } from '../../lib/i18n/strings'
import BrowseList from '../primitives/BrowseList.astro'
import CharacterHero from '../primitives/CharacterHero.astro'
import Heraldry from '../primitives/Heraldry.astro'
import RuleText from '../primitives/RuleText.astro'
import SectionHead from '../primitives/SectionHead.astro'
import SectionTrail from '../primitives/SectionTrail.astro'
import '../../styles/prose.css'
import '../../styles/reading.css'

type Props = { locale: Locale; corpus: Corpus; species: ResolvedSpecies }

const { locale, corpus, species } = Astro.props
const t = strings(locale)

const named = (map: Corpus['languages'], keys: string[]): string[] =>
  keys.map((key) => label(map.get(key), locale, key))

const SUBSPECIES_WORDS: Record<SubspeciesLabel, { plural: string; singular: string }> = {
  'regional-origins': { plural: t.regionalOrigins, singular: t.regionalOrigin_ },
  subspecies: { plural: t.subspecies, singular: t.subspecies_ },
}
const words = SUBSPECIES_WORDS[species.subspeciesLabel]
const SUBSPECIES_ID = SUBSPECIES_SECTIONS[species.subspeciesLabel]
const PLAYING_ID = 'jouer'

const subspeciesNamed = species.subspecies.map((sub) => ({
  ...sub,
  familyNames: sub.names?.family ?? species.familyNames,
}))

const languages = named(corpus.languages, species.languages ?? [])
const roleplay = species.roleplay
const playing = [
  ...(roleplay?.adulthood ? [{ label: t.adulthood, value: roleplay.adulthood }] : []),
  ...(roleplay?.lifespan ? [{ label: t.lifespan, value: roleplay.lifespan }] : []),
  ...(roleplay?.height ? [{ label: t.height, value: roleplay.height }] : []),
  ...(languages.length > 0 ? [{ label: t.languages, value: languages.join(', ') }] : []),
]
const hasSubspecies = species.subspecies.length > 0
const hasPlaying = roleplay?.text !== undefined || playing.length > 0 || hasSubspecies

const lore = await loreFor('species', species.id, locale)
const LoreOpening = lore?.opening?.Content
const LoreSections = lore?.sections?.Content
const hasPlayReading = LoreOpening !== undefined || hasPlaying

function numbered<T extends object>(sections: T[]) {
  return sections.map((section, position) => ({
    ...section,
    num: String(position + 1).padStart(2, '0'),
  }))
}

const playTrail = numbered([
  ...(hasPlaying ? [{ text: t.playingAs(species.name), href: `#${PLAYING_ID}` }] : []),
  ...(hasSubspecies
    ? [
        {
          text: words.plural,
          href: `#${SUBSPECIES_ID}`,
          sections: species.subspecies.map((sub) => ({
            text: sub.name,
            href: `#${subspeciesAnchor(sub.id)}`,
          })),
        },
      ]
    : []),
  { text: t.speciesOffer, href: '#skills' },
])
const loreTrail = numbered(
  (lore?.sections?.headings ?? [])
    .filter((heading) => heading.depth === 2)
    .map((heading) => ({ text: heading.text, href: `#${heading.slug}` })),
)
const trailParts = [
  { label: t.speciesPlayPart, sections: playTrail },
  { label: t.speciesLorePart, sections: loreTrail },
].filter((part) => part.sections.length > 0)

const entries = skillBrowseEntries(species.pool, corpus, locale, species)
---

<div>
  <CharacterHero locale={locale} sheet={speciesSheet(species, corpus, locale)} />

  {
    hasPlayReading && (
      <div class="au-reading au-species-play">
        {playTrail.length + loreTrail.length > 1 && (
          <nav class="au-aside" aria-label={t.onThisPage}>
            {trailParts.map((part) => (
              <div class="au-trail-part">
                <p class="au-eyebrow">{part.label}</p>
                <SectionTrail sections={part.sections} label={part.label} />
              </div>
            ))}
          </nav>
        )}
        <div class="au-reading__body">
          <div class="au-prose">
            {LoreOpening && <LoreOpening />}

            {hasPlaying && (
              <section>
                <h2 id={PLAYING_ID}>{t.playingAs(species.name)}</h2>
                {roleplay?.text && <RuleText source={roleplay.text} corpus={corpus} locale={locale} />}
                {(playing.length > 0 || hasSubspecies) && (
                  <dl>
                    {playing.map((row) => (
                      <>
                        <dt>{row.label}</dt>
                        <dd>{row.value}</dd>
                      </>
                    ))}
                    {hasSubspecies && (
                      <>
                        <dt>{words.plural}</dt>
                        <dd>
                          {species.subspecies.map((sub, index) => (
                            <>
                              {index > 0 && ', '}
                              <a href={`#${subspeciesAnchor(sub.id)}`}>{sub.name}</a>
                            </>
                          ))}
                        </dd>
                      </>
                    )}
                  </dl>
                )}
              </section>
            )}

            {hasSubspecies && (
              <section>
                <h2 id={SUBSPECIES_ID}>{words.plural}</h2>
                {subspeciesNamed.map((sub) => (
                  <article id={subspeciesAnchor(sub.id)} class="au-subspecies">
                    <h3>{sub.name}</h3>
                    {sub.heraldry && HERALDRY_PLACEMENT[sub.heraldry.kind] === 'beside' ? (
                      <div class="au-subspecies__flanked">
                        <Heraldry
                          locale={locale}
                          heraldry={sub.heraldry}
                          id={`blason-${species.id}-${sub.id}`}
                        />
                        <div class="au-subspecies__beside">
                          <RuleText source={sub.text} corpus={corpus} locale={locale} />
                        </div>
                      </div>
                    ) : (
                      <>
                        {sub.heraldry && (
                          <Heraldry
                            locale={locale}
                            heraldry={sub.heraldry}
                            id={`blason-${species.id}-${sub.id}`}
                          />
                        )}
                        <RuleText source={sub.text} corpus={corpus} locale={locale} />
                      </>
                    )}
                    {(sub.imposedSkill || sub.names || sub.familyNames) && (
                      <dl>
                        {sub.imposedSkill && (
                          <>
                            <dt>{t.imposedSkill}</dt>
                            <dd>
                              <a href={`#e-${sub.imposedSkill.id}`}>{sub.imposedSkill.title}</a>
                            </dd>
                          </>
                        )}
                        {sub.names && (
                          <>
                            {sub.names.masculine && (
                              <>
                                <dt>{t.namesMasculine}</dt>
                                <dd>{sub.names.masculine.join(', ')}</dd>
                              </>
                            )}
                            {sub.names.feminine && (
                              <>
                                <dt>{t.namesFeminine}</dt>
                                <dd>{sub.names.feminine.join(', ')}</dd>
                              </>
                            )}
                            {sub.names.given && (
                              <>
                                <dt>{t.namesGiven}</dt>
                                <dd>{sub.names.given.join(', ')}</dd>
                              </>
                            )}
                          </>
                        )}
                        {sub.familyNames && (
                          <>
                            <dt>{species.familyNamesLabel ?? t.namesFamily}</dt>
                            <dd>{sub.familyNames.join(', ')}</dd>
                          </>
                        )}
                      </dl>
                    )}
                  </article>
                ))}
              </section>
            )}
          </div>
        </div>
      </div>
    )
  }

  <section>
    <div style="max-width:1560px; margin:0 auto; padding:40px 26px 0">
      <SectionHead
        title={t.speciesOffer}
        count={`${formatNumber(species.pool.length, locale)} ${t.entries_}`}
        id="skills"
      />
      {
        species.pool.length === 0 && (
          <p style="margin:0; padding-bottom:80px; max-width:var(--measure); font-size:var(--prose-body); line-height:1.7; color:var(--ink2)">
            {t.speciesEmpty}
          </p>
        )
      }
    </div>
    {
      species.pool.length > 0 && (
        <BrowseList
          locale={locale}
          corpus={corpus}
          entries={entries}
          label={t.speciesOffer}
          variant="speciesSkills"
          subspeciesLabel={words.singular}
        />
      )
    }
  </section>

  {
    LoreSections && (
      <div class="au-reading">
        {loreTrail.length > 1 && (
          <nav class="au-aside" aria-label={t.speciesLorePart}>
            <p class="au-eyebrow">{t.speciesLorePart}</p>
            <SectionTrail sections={loreTrail} />
          </nav>
        )}
        <div class="au-reading__body">
          <div class="au-prose">
            <LoreSections />
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  .au-reading {
    padding-block-start: 40px;
  }

  .au-species-play {
    padding-block-end: 0;
  }

  .au-trail-part + .au-trail-part {
    margin-block-start: 22px;
  }

  .au-subspecies {
    scroll-margin-top: var(--sticky-top);
  }

  .au-subspecies__flanked {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    row-gap: 0.4em;
    margin-block-start: 1em;
  }

  .au-subspecies__flanked > :global(.au-heraldry) {
    inline-size: 9rem;
  }

  .au-subspecies__beside {
    justify-self: stretch;
  }

  @media (width >= 30rem) {
    .au-subspecies__flanked {
      grid-template-columns: clamp(7.5rem, 26%, 12rem) minmax(0, 1fr);
      column-gap: clamp(1.25rem, 4%, 2.25rem);
      align-items: start;
      justify-items: stretch;
    }

    .au-subspecies__flanked > :global(.au-heraldry) {
      inline-size: auto;
    }

    .au-subspecies__beside :global(.au-rule-text > :first-child) {
      margin-block-start: 0;
    }
  }
</style>
