---
import { bookChapter } from '../../lib/game/book-chapters'
import { speciesSheet } from '../../lib/game/character-sheet'
import type { Corpus } from '../../lib/game/corpus'
import { speciesCards } from '../../lib/game/hub-cards'
import { HUB_CHAPTERS, leadOrder } from '../../lib/game/hubs'
import type { Locale } from '../../lib/i18n/locales'
import { strings } from '../../lib/i18n/strings'
import { selectEntries } from '../../lib/select-entries'
import { stageSource } from '../../lib/stage-ambient'
import FilterBar from '../primitives/FilterBar.astro'
import SelectScreen from '../primitives/SelectScreen.astro'

type Props = { locale: Locale; corpus: Corpus }

const { locale, corpus } = Astro.props
const t = strings(locale)

const species = new Map(corpus.species.map((entry) => [entry.id, entry]))
const sheetOf = (id: string) => {
  const entry = species.get(id)
  if (!entry) throw new Error(`the species index has a card for ${id}, which is not a species`)
  return speciesSheet(entry, corpus, locale)
}
const chapter = await bookChapter(locale, HUB_CHAPTERS.species)
const cards = await speciesCards(corpus, locale)
const entries = await selectEntries(cards, sheetOf)
const order = leadOrder(
  entries.map((entry) => ({ ...entry.card, id: entry.card.facets.id })),
  locale,
)
const lead = order[0]
if (!lead) throw new Error('the species index has no species to stage')
const leadStage = stageSource(lead.cover, lead.seal.colours)
---

<SelectScreen
  locale={locale}
  title={t.speciesIndex}
  about={{ body: t.speciesLead, link: { href: chapter.href, label: t.hubChapter(chapter.title) } }}
  stage={leadStage}
  groups={[{ key: 'species', label: undefined, entries }]}
  order={order.map((card) => card.id)}
>
  <FilterBar
    slot="filter"
    locale={locale}
    variant="species"
    total={cards.length}
    drafts={cards.filter((card) => card.status === 'draft').length}
  />
</SelectScreen>
