---
import { HTML_LANG, LOCALE_FLAG, LOCALE_NAME, LOCALES } from '../../lib/i18n/locales'
import { pathFor } from '../../lib/i18n/routes'
import { strings } from '../../lib/i18n/strings'
import Logo from '../shell/Logo.astro'
---

<section data-threshold>
  <div data-threshold-mark>
    <Logo size={72} color="var(--gold)" />
    <h1 translate="no">Aubaine</h1>
  </div>

  <div data-threshold-choice>
    <noscript>
      <p data-threshold-prompt>
        {
          LOCALES.map((locale) => (
            <span lang={HTML_LANG[locale]}>{strings(locale).chooseLanguage}</span>
          ))
        }
      </p>
    </noscript>
    <ul data-threshold-languages>
      {
        LOCALES.map((locale) => (
          <li>
            <a
              href={pathFor('home', locale)}
              hreflang={locale}
              lang={HTML_LANG[locale]}
              data-swup-history="replace"
              data-threshold-language
            >
              <span
                aria-hidden="true"
                data-threshold-flag
                style={`background-image:url('${LOCALE_FLAG[locale]}')`}
              />
              <span>{LOCALE_NAME[locale]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  [data-threshold] {
    flex: 1;
    min-height: calc(100dvh - var(--header-h));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    padding: clamp(28px, 7dvh, 72px) 26px clamp(24px, 6dvh, 56px);
    background: radial-gradient(90% 90% at 50% 45%, var(--bg2), var(--bg) 70%);
  }

  [data-threshold-mark] {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
  }

  h1 {
    margin: 0;
    padding-inline-start: 0.22em;
    font-family: var(--font-display);
    font-size: clamp(30px, 6vw, 56px);
    font-weight: 700;
    letter-spacing: 0.22em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
  }

  [data-threshold-choice] {
    position: relative;
    z-index: 41;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  [data-threshold-prompt] {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding-inline-start: 0.22em;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-align: center;
    text-transform: uppercase;
    color: var(--ink3);
  }

  [data-threshold-languages] {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  [data-threshold-language] {
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 44px;
    padding: 10px 18px;
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    border: 1px solid var(--line2);
    transition: border-color 0.2s var(--ease);
  }

  [data-threshold-language]:hover {
    border-color: var(--gold);
  }

  [data-threshold-flag] {
    flex: none;
    width: 22px;
    height: 15px;
    border: 1px solid var(--line);
    background: center / 100% 100% no-repeat;
  }
</style>
