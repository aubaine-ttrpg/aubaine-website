---
import { bookChapter } from '../../lib/game/book-chapters'
import { treeSheet } from '../../lib/game/character-sheet'
import type { Corpus } from '../../lib/game/corpus'
import { treeCards } from '../../lib/game/hub-cards'
import { HUB_CHAPTERS, leadOrder } from '../../lib/game/hubs'
import type { Locale } from '../../lib/i18n/locales'
import { strings } from '../../lib/i18n/strings'
import { selectEntries } from '../../lib/select-entries'
import { stageSource } from '../../lib/stage-ambient'
import FilterBar from '../primitives/FilterBar.astro'
import SelectScreen from '../primitives/SelectScreen.astro'

type Props = { locale: Locale; corpus: Corpus }

const { locale, corpus } = Astro.props
const t = strings(locale)

const trees = new Map(corpus.trees.map((tree) => [tree.id, tree]))
const sheetOf = (id: string) => {
  const tree = trees.get(id)
  if (!tree) throw new Error(`the trees index has a card for ${id}, which is not a tree`)
  return treeSheet(tree, corpus, locale)
}
const chapter = await bookChapter(locale, HUB_CHAPTERS.trees)
const cards = await treeCards(corpus, locale)
const entries = await selectEntries(cards, sheetOf)
const order = leadOrder(
  entries.map((entry) => ({ ...entry.card, id: entry.card.facets.id })),
  locale,
)
const lead = order[0]
if (!lead) throw new Error('the trees index has no tree to stage')
const leadStage = stageSource(lead.cover, lead.seal.colours)
const groups = [
  {
    key: 'archetype',
    label: t.archetypes,
    entries: entries.filter((entry) => entry.card.facets.kind?.values !== 'domain'),
  },
  {
    key: 'domain',
    label: t.domains,
    entries: entries.filter((entry) => entry.card.facets.kind?.values === 'domain'),
  },
]
---

<SelectScreen
  locale={locale}
  title={t.trees}
  about={{ body: t.treesLead, link: { href: chapter.href, label: t.hubChapter(chapter.title) } }}
  stage={leadStage}
  groups={groups}
  order={order.map((card) => card.id)}
>
  <FilterBar
    slot="filter"
    locale={locale}
    variant="trees"
    total={cards.length}
    drafts={cards.filter((card) => card.status === 'draft').length}
  />
</SelectScreen>
